{
  "name": "@nop-chaos/flux-renderers-form-advanced",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@nop-chaos/flux-core": "workspace:*",
    "@nop-chaos/flux-i18n": "workspace:*",
    "@nop-chaos/flux-react": "workspace:*",
    "@nop-chaos/flux-renderers-content": "workspace:*",
    "@nop-chaos/flux-renderers-form": "workspace:*",
    "@nop-chaos/flux-runtime": "workspace:*",
    "@nop-chaos/ui": "workspace:*",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5"
  },
  "peerDependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-build-assets.mjs src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx --cache --cache-location node_modules/.cache/eslint"
  },
  "devDependencies": {
    "@nop-chaos/flux-formula": "workspace:*",
    "@nop-chaos/flux-renderers-basic": "workspace:*",
    "@nop-chaos/flux-renderers-data": "workspace:*",
    "@tiptap/core": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0"
  },
  "description": "Advanced form renderers: condition builder, tag list, and detail views"
}
