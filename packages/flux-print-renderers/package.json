{
  "name": "@nop-chaos/flux-print-renderers",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./print-designer.css": {
      "default": "./dist/print-designer.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-build-assets.mjs src/print-designer.css dist/print-designer.css",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx --cache --cache-location node_modules/.cache/eslint"
  },
  "dependencies": {
    "@nop-chaos/editor-core": "workspace:*",
    "@nop-chaos/flux-i18n": "workspace:*",
    "@nop-chaos/flux-print-core": "workspace:*",
    "@nop-chaos/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0"
  },
  "description": "React interaction layer for the web print system: designer canvas renderers, palette defaults, and preview"
}
