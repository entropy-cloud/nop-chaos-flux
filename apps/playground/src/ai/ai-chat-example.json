{
  "type": "page",
  "xui:imports": [{ "from": "ai", "as": "ai" }],
  "body": [
    {
      "type": "ai-chat",
      "testid": "ai-chat-demo",
      "connector": "${$ai.connectors.mock}",
      "placeholder": "Ask the mock AI anything…",
      "submitType": "enter",
      "showWordLimit": false,
      "showTimestamp": true,
      "header": {
        "type": "flex",
        "direction": "row",
        "align": "center",
        "justify": "between",
        "className": "p-3 border-b",
        "body": [
          { "type": "text", "text": "AI Chat (mock connector)" },
          {
            "type": "text",
            "text": "P0 skeleton — streaming echo demo",
            "className": "text-xs text-muted-foreground"
          }
        ]
      },
      "className": "flex flex-col h-[70vh] max-w-3xl mx-auto p-4 gap-3"
    }
  ]
}
