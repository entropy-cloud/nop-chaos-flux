{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nop-chaos.dev/schemas/devtools/visual-baseline.schema.json",
  "title": "Flux DevTools VisualBaseline (frozen v1)",
  "description": "Versioned visual baseline entry. Design: capture design §8. imageRef points at gateway object storage; local-mode baselines use a file/data ref outside git per repo media policy.",
  "type": "object",
  "required": ["key", "imageRef", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "description": "schemaFingerprint + viewport + step identifier"
    },
    "imageRef": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "number" },
    "schemaFingerprint": { "type": "string" },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "ignoreRegions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason"],
        "additionalProperties": false,
        "properties": {
          "cid": {
            "type": "string",
            "description": "schema-aware ignore region (xui:visual-ignore)"
          },
          "rect": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
