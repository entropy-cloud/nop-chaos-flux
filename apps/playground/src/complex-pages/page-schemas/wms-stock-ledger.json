{
  "type": "page",
  "body": [
    {
      "type": "data-source",
      "id": "wms-stock-ledger-rows-source",
      "name": "ledgerRows",
      "action": "ajax",
      "args": {
        "url": "/r/ReplWms__stockLedgerRows",
        "method": "get",
        "params": {
          "warehouse": "${ledgerFilter?.warehouse ?? ''}",
          "batchNo": "${ledgerFilter?.batchNo ?? ''}"
        }
      },
      "dependsOn": ["ledgerFilter"],
      "testid": "wms-stock-ledger-rows-source"
    },
    {
      "type": "data-source",
      "id": "wms-stock-ledger-kpi-source",
      "name": "stockKpi",
      "action": "ajax",
      "args": {
        "url": "/r/ReplWms__stockKpi",
        "method": "get"
      },
      "testid": "wms-stock-ledger-kpi-source"
    },
    {
      "type": "data-source",
      "id": "wms-stock-ledger-batch-trace-source",
      "name": "batchTrace",
      "action": "ajax",
      "args": {
        "url": "/r/ReplWms__batchTrace",
        "method": "get",
        "params": {
          "batchNo": "${traceBatchNo ?? ''}"
        }
      },
      "initFetch": false,
      "testid": "wms-stock-ledger-batch-trace-source"
    },
    {
      "type": "data-source",
      "id": "wms-stock-ledger-recon-source",
      "name": "reconCheck",
      "action": "ajax",
      "args": {
        "url": "/r/ReplWms__reconCheck",
        "method": "get"
      },
      "testid": "wms-stock-ledger-recon-source"
    },
    {
      "type": "flex",
      "direction": "column",
      "gap": 8,
      "testid": "wms-stock-ledger-root",
      "body": [
        {
          "type": "flex",
          "direction": "row",
          "gap": 12,
          "className": "items-center flex-wrap",
          "body": [
            {
              "type": "form",
              "id": "wms-stock-ledger-filter-form",
              "testid": "wms-stock-ledger-filter",
              "valuesPath": "ledgerFilter",
              "mode": "inline",
              "data": {
                "warehouse": "",
                "batchNo": ""
              },
              "body": [
                {
                  "type": "select",
                  "name": "warehouse",
                  "label": "仓库",
                  "testid": "wms-stock-ledger-filter-warehouse",
                  "placeholder": "全部仓库",
                  "options": [
                    { "label": "全部仓库", "value": "" },
                    { "label": "WH-A", "value": "WH-A" },
                    { "label": "WH-B", "value": "WH-B" }
                  ]
                },
                {
                  "type": "input-text",
                  "name": "batchNo",
                  "label": "批次",
                  "testid": "wms-stock-ledger-filter-batch",
                  "placeholder": "批次号，如 B2026-015"
                }
              ]
            },
            {
              "type": "button",
              "label": "导出台账报表",
              "variant": "outline",
              "testid": "wms-stock-ledger-export",
              "onClick": {
                "action": "download",
                "args": {
                  "url": "/r/ReplWms__ledgerReport?format=xlsx",
                  "filename": "库存收发存台账-xlsx.csv"
                },
                "then": {
                  "action": "showToast",
                  "args": {
                    "level": "success",
                    "message": "台账报表已生成并开始下载"
                  }
                },
                "onError": [
                  {
                    "action": "showToast",
                    "args": {
                      "level": "error",
                      "message": "台账报表导出失败"
                    }
                  }
                ]
              }
            },
            {
              "type": "button",
              "label": "导出（非法格式演练）",
              "variant": "ghost",
              "testid": "wms-stock-ledger-export-invalid",
              "onClick": {
                "action": "download",
                "args": {
                  "url": "/r/ReplWms__ledgerReport?format=docx",
                  "filename": "库存收发存台账-docx.csv"
                },
                "onError": [
                  {
                    "action": "showToast",
                    "args": {
                      "level": "error",
                      "message": "台账报表导出失败（不支持的格式）"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "flex",
          "direction": "row",
          "gap": 12,
          "className": "flex-wrap",
          "testid": "wms-stock-ledger-kpi-band",
          "body": [
            {
              "type": "stat-tile",
              "testid": "wms-stock-ledger-kpi-in",
              "label": "本期收入合计",
              "value": "${stockKpi?.kpis?.totalInQty ?? 0}",
              "formatter": { "thousands": true, "decimals": 0 }
            },
            {
              "type": "stat-tile",
              "testid": "wms-stock-ledger-kpi-out",
              "label": "本期发出合计",
              "value": "${stockKpi?.kpis?.totalOutQty ?? 0}",
              "formatter": { "thousands": true, "decimals": 0 }
            },
            {
              "type": "stat-tile",
              "testid": "wms-stock-ledger-kpi-balance",
              "label": "期末结存合计",
              "value": "${stockKpi?.kpis?.totalBalanceQty ?? 0}",
              "formatter": { "thousands": true, "decimals": 0 }
            },
            {
              "type": "stat-tile",
              "testid": "wms-stock-ledger-kpi-batches",
              "label": "批次总数",
              "value": "${stockKpi?.kpis?.batchCount ?? 0}"
            }
          ]
        },
        {
          "type": "card",
          "testid": "wms-stock-ledger-recon-card",
          "title": "对账一致性",
          "body": [
            {
              "type": "flex",
              "direction": "row",
              "gap": 12,
              "className": "items-center flex-wrap",
              "body": [
                {
                  "type": "status",
                  "testid": "wms-stock-ledger-recon-status",
                  "value": "${reconCheck?.consistent ? 'reconciled' : 'drift'}",
                  "labelMap": {
                    "reconciled": "账实一致",
                    "drift": "账实不平"
                  },
                  "levelMap": {
                    "reconciled": "success",
                    "drift": "error"
                  }
                },
                {
                  "type": "text",
                  "testid": "wms-stock-ledger-recon-message",
                  "text": "${reconCheck?.message ?? '对账检查中…'}",
                  "className": "text-sm text-muted-foreground"
                },
                {
                  "type": "button",
                  "label": "重新对账",
                  "variant": "outline",
                  "testid": "wms-stock-ledger-recon-refresh",
                  "onClick": {
                    "action": "refreshSource",
                    "targetId": "reconCheck"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "pivot-table",
          "id": "wms-stock-ledger-pivot",
          "testid": "wms-stock-ledger-pivot",
          "label": "库存收发存透视（仓库×库位×物料×批次）",
          "source": "${ledgerRows?.items ?? []}",
          "rowDimensions": ["warehouse", "locationCode", "materialName", "batchNo"],
          "columnDimensions": ["month"],
          "indicators": [
            { "field": "qtyIn", "title": "收入", "aggregationType": "SUM" },
            { "field": "qtyOut", "title": "发出", "aggregationType": "SUM" },
            { "field": "qtyBalance", "title": "结存", "aggregationType": "SUM" }
          ],
          "dataConfig": {
            "totals": {
              "row": {
                "showGrandTotals": true,
                "showSubTotals": true,
                "subTotalsDimensions": ["warehouse"],
                "grandTotalLabel": "总计"
              }
            }
          },
          "height": 360,
          "onCellClick": {
            "action": "setValue",
            "args": {
              "path": "traceBatchNo",
              "value": "${cellHeaderPaths?.rowHeaderPaths?.[3]?.value ?? ''}"
            },
            "then": {
              "action": "refreshSource",
              "targetId": "batchTrace",
              "then": {
                "action": "openDialog",
                "args": {
                  "title": "批次追溯 ${traceBatchNo}",
                  "testid": "wms-stock-ledger-trace-dialog",
                  "body": [
                    {
                      "type": "table",
                      "testid": "wms-stock-ledger-trace-table",
                      "source": "${batchTrace?.items ?? []}",
                      "itemKey": "moveNo",
                      "pagination": { "enabled": false },
                      "columns": [
                        { "name": "moveNo", "label": "移动单号", "width": 170 },
                        { "name": "direction", "label": "收/发", "width": 90 },
                        { "name": "qty", "label": "数量", "width": 90 },
                        { "name": "occurredAt", "label": "发生时间", "width": 160 }
                      ],
                      "empty": { "type": "text", "text": "该批次无移动记录" }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "table",
          "testid": "wms-stock-ledger-detail-table",
          "source": "${ledgerRows?.items ?? []}",
          "itemKey": "batchNo",
          "pagination": { "enabled": false },
          "columns": [
            { "name": "warehouse", "label": "仓库", "width": 90 },
            { "name": "locationCode", "label": "库位", "width": 110 },
            { "name": "materialCode", "label": "物料编码", "width": 110 },
            { "name": "materialName", "label": "物料", "width": 150 },
            { "name": "batchNo", "label": "批次", "width": 120 },
            { "name": "month", "label": "月份", "width": 100 },
            { "name": "qtyIn", "label": "收入", "width": 90 },
            { "name": "qtyOut", "label": "发出", "width": 90 },
            { "name": "qtyBalance", "label": "结存", "width": 90 }
          ],
          "empty": { "type": "text", "text": "暂无台账明细" }
        }
      ]
    }
  ]
}
