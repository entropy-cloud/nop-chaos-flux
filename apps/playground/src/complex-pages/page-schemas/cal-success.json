{
  "type": "page",
  "testid": "cal-success-page",
  "className": "cal-root",
  "body": [
    {
      "type": "data-source",
      "name": "event",
      "action": "ajax",
      "args": { "url": "/r/Cal__event", "method": "get" }
    },
    {
      "type": "data-source",
      "name": "booking",
      "action": "ajax",
      "args": { "url": "/r/Cal__latestBooking", "method": "get" }
    },
    {
      "type": "container",
      "className": "max-w-2xl mx-auto px-6 py-12 flex flex-col gap-6",
      "testid": "cal-success-main",
      "body": [
        {
          "type": "container",
          "className": "flex flex-col items-center text-center gap-3",
          "testid": "cal-success-head",
          "body": [
            {
              "type": "container",
              "className": "cal-check-circle",
              "testid": "cal-success-check",
              "body": [{ "type": "icon", "icon": "check", "size": 32 }]
            },
            {
              "type": "text",
              "text": "预约已确认",
              "className": "cal-title",
              "testid": "cal-success-title"
            },
            {
              "type": "text",
              "text": "一封确认邮件已发送给你，如需调整请使用下方链接。",
              "className": "cal-desc",
              "testid": "cal-success-description"
            },
            {
              "type": "text",
              "text": "${booking?.status === 'cancelled' ? '已取消' : '待确认'}",
              "className": "cal-badge cal-badge-pending",
              "testid": "cal-success-pending-badge",
              "visible": "${booking?.status !== 'confirmed'}"
            }
          ]
        },
        {
          "type": "container",
          "testid": "cal-success-summary",
          "className": "cal-summary-card flex flex-col gap-2",
          "body": [
            {
              "type": "container",
              "className": "cal-summary-host",
              "body": [
                {
                  "type": "container",
                  "className": "cal-avatar",
                  "testid": "cal-success-avatar",
                  "body": [{ "type": "text", "text": "${event?.hostInitials}" }]
                },
                {
                  "type": "container",
                  "className": "flex flex-col",
                  "body": [
                    { "type": "text", "text": "${event?.hostName}", "className": "font-medium" },
                    {
                      "type": "text",
                      "text": "${event?.username}",
                      "className": "cal-summary-label"
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "text": "${event?.title}",
              "className": "cal-summary-value",
              "testid": "cal-success-summary-title"
            },
            {
              "type": "flex",
              "direction": "row",
              "gap": 6,
              "className": "items-center cal-meta-row",
              "body": [
                { "type": "icon", "icon": "clock", "size": 14 },
                {
                  "type": "text",
                  "text": "${booking?.durationText ?? event?.preview?.durationText}",
                  "testid": "cal-success-summary-duration"
                }
              ]
            },
            {
              "type": "flex",
              "direction": "row",
              "gap": 6,
              "className": "items-center cal-meta-row",
              "body": [
                { "type": "icon", "icon": "video", "size": 14 },
                {
                  "type": "text",
                  "text": "${event?.location}",
                  "testid": "cal-success-summary-location"
                }
              ]
            },
            {
              "type": "flex",
              "direction": "row",
              "gap": 6,
              "className": "items-center cal-meta-row",
              "body": [
                { "type": "icon", "icon": "globe", "size": 14 },
                {
                  "type": "text",
                  "text": "${event?.timezoneLabel}",
                  "testid": "cal-success-summary-timezone"
                }
              ]
            },
            {
              "type": "flex",
              "direction": "row",
              "gap": 6,
              "className": "items-center cal-meta-row",
              "body": [
                { "type": "icon", "icon": "calendar", "size": 14 },
                {
                  "type": "text",
                  "text": "${booking?.dateText ?? event?.preview?.dateText} ${booking?.timeText ?? event?.preview?.timeText}",
                  "testid": "cal-success-summary-time"
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "testid": "cal-success-calendar-links",
          "className": "flex flex-col gap-2",
          "body": [
            { "type": "text", "text": "添加到日历", "className": "cal-slot-group-label" },
            {
              "type": "link",
              "testid": "cal-success-link-google",
              "href": "#/complex-pages/cal-success",
              "className": "cal-cal-link-row",
              "label": [
                { "type": "icon", "icon": "calendar", "size": 16 },
                { "type": "text", "text": "Google 日历" }
              ]
            },
            {
              "type": "link",
              "testid": "cal-success-link-outlook",
              "href": "#/complex-pages/cal-success",
              "className": "cal-cal-link-row",
              "label": [
                { "type": "icon", "icon": "calendar", "size": 16 },
                { "type": "text", "text": "Outlook 日历" }
              ]
            },
            {
              "type": "link",
              "testid": "cal-success-link-office365",
              "href": "#/complex-pages/cal-success",
              "className": "cal-cal-link-row",
              "label": [
                { "type": "icon", "icon": "calendar", "size": 16 },
                { "type": "text", "text": "Office 365 日历" }
              ]
            },
            {
              "type": "link",
              "testid": "cal-success-link-ics",
              "href": "#/complex-pages/cal-success",
              "className": "cal-cal-link-row",
              "label": [
                { "type": "icon", "icon": "download", "size": 16 },
                { "type": "text", "text": "下载 ICS 文件" }
              ]
            }
          ]
        },
        {
          "type": "flex",
          "direction": "row",
          "gap": 12,
          "className": "items-center justify-between",
          "testid": "cal-success-actions",
          "body": [
            {
              "type": "button",
              "label": "复制链接",
              "icon": "link",
              "className": "cal-btn cal-btn-primary",
              "testid": "cal-success-copy-link",
              "onClick": {
                "action": "ajax",
                "args": { "url": "/r/Cal__shareLink", "method": "get" },
                "messages": { "success": "链接已复制" }
              }
            },
            {
              "type": "flex",
              "direction": "row",
              "gap": 12,
              "className": "items-center",
              "testid": "cal-success-rebook-links",
              "body": [
                {
                  "type": "button",
                  "label": "重新安排",
                  "className": "cal-btn cal-btn-link",
                  "testid": "cal-success-reschedule",
                  "onClick": {
                    "action": "navigate",
                    "args": { "url": "#/complex-pages/cal-booking" }
                  }
                },
                {
                  "type": "button",
                  "label": "取消预约",
                  "className": "cal-btn cal-btn-link",
                  "testid": "cal-success-cancel",
                  "onClick": {
                    "action": "openDialog",
                    "args": {
                      "title": "取消预约",
                      "testid": "cal-cancel-dialog",
                      "className": "cal-dialog",
                      "closeOnSubmit": true,
                      "onSubmitSuccess": {
                        "action": "navigate",
                        "args": { "url": "#/complex-pages/cal-booking" },
                        "control": { "debounce": 1200 }
                      },
                      "body": [
                        {
                          "type": "form",
                          "id": "cal-cancel-form",
                          "testid": "cal-cancel-form",
                          "submitScope": "surface",
                          "submitAction": {
                            "action": "ajax",
                            "args": {
                              "url": "/r/Cal__cancelBooking",
                              "method": "post",
                              "includeScope": "*"
                            },
                            "messages": {
                              "success": "预约已取消",
                              "failed": "没有可取消的预约"
                            }
                          },
                          "body": [
                            {
                              "type": "textarea",
                              "name": "reason",
                              "label": "取消原因（可选）",
                              "placeholder": "告诉我们原因，帮助我们改进",
                              "testid": "cal-cancel-reason"
                            }
                          ],
                          "actions": [
                            {
                              "type": "button",
                              "label": "保留预约",
                              "className": "cal-btn cal-btn-outline",
                              "testid": "cal-cancel-dialog-cancel",
                              "onClick": { "action": "closeSurface" }
                            },
                            {
                              "type": "button",
                              "label": "确认取消",
                              "className": "cal-btn cal-btn-primary",
                              "testid": "cal-cancel-dialog-confirm",
                              "onClick": { "action": "submitForm" }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
