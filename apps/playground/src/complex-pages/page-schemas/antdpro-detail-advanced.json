{
  "type": "page",
  "testid": "antdpro-detail-advanced-page",
  "className": "adp-root",
  "body": [
    {
      "type": "data-source",
      "name": "detail",
      "action": "ajax",
      "args": {
        "url": "/r/AntdPro__orderDetail",
        "method": "get"
      }
    },
    {
      "type": "container",
      "testid": "antdpro-detail-advanced-header",
      "className": "adp-page-header px-5 pt-4 pb-4 mb-4 rounded-lg",
      "body": [
        {
          "type": "flex",
          "direction": "row",
          "gap": 6,
          "className": "items-center adp-breadcrumb",
          "body": [
            {
              "type": "text",
              "text": "项目中心",
              "className": "adp-breadcrumb-link"
            },
            {
              "type": "text",
              "text": "/"
            },
            {
              "type": "text",
              "text": "订单管理",
              "className": "adp-breadcrumb-link"
            },
            {
              "type": "text",
              "text": "/"
            },
            {
              "type": "text",
              "text": "高级详情"
            }
          ]
        },
        {
          "type": "flex",
          "direction": "row",
          "gap": 12,
          "className": "items-center justify-between mt-2",
          "body": [
            {
              "type": "text",
              "text": "订单详情（高级）",
              "className": "adp-page-title",
              "testid": "antdpro-detail-advanced-title"
            },
            {
              "type": "flex",
              "direction": "row",
              "gap": 8,
              "className": "items-center",
              "testid": "antdpro-detail-approve-group",
              "body": [
                {
                  "type": "button",
                  "label": "驳回",
                  "className": "adp-btn adp-btn-outline",
                  "testid": "antdpro-approve-reject",
                  "onClick": {
                    "action": "ajax",
                    "args": {
                      "url": "/r/AntdPro__approveOrder",
                      "method": "post",
                      "data": {
                        "id": "${detail?.id ?? \"\"}",
                        "decision": "reject"
                      }
                    },
                    "messages": {
                      "success": "已驳回，订单关闭"
                    },
                    "then": {
                      "action": "refreshSource",
                      "targetId": "detail"
                    }
                  }
                },
                {
                  "type": "button",
                  "label": "通过",
                  "className": "adp-btn adp-btn-primary",
                  "testid": "antdpro-approve-approve",
                  "onClick": {
                    "action": "ajax",
                    "args": {
                      "url": "/r/AntdPro__approveOrder",
                      "method": "post",
                      "data": {
                        "id": "${detail?.id ?? \"\"}",
                        "decision": "approve"
                      }
                    },
                    "messages": {
                      "success": "审批通过"
                    },
                    "then": {
                      "action": "refreshSource",
                      "targetId": "detail"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "className": "adp-card p-6 mb-4 max-w-5xl mx-auto w-full",
      "testid": "antdpro-detail-advanced-progress-card",
      "body": [
        {
          "type": "text",
          "text": "执行进度",
          "className": "adp-card-title mb-4"
        },
        {
          "type": "steps",
          "testid": "antdpro-detail-steps",
          "valueOwnership": "controlled",
          "value": "${detail?.progressKey ?? 'created'}",
          "items": [
            {
              "value": "created",
              "title": "创建订单",
              "description": "订单创建并风控校验"
            },
            {
              "value": "confirmed",
              "title": "财务确认",
              "description": "收款确认完成"
            },
            {
              "value": "shipped",
              "title": "仓库发货",
              "description": "物流揽收发出"
            },
            {
              "value": "completed",
              "title": "客户签收",
              "description": "订单完成闭环"
            }
          ]
        }
      ]
    },
    {
