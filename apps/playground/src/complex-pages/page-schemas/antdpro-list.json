{
  "type": "page",
  "testid": "antdpro-list-page",
  "className": "adp-root",
  "body": [
    {
      "type": "container",
      "testid": "antdpro-page-header",
      "className": "adp-page-header px-5 pt-4 pb-4 mb-4 rounded-lg",
      "body": [
        {
          "type": "flex",
          "direction": "row",
          "gap": 6,
          "className": "items-center adp-breadcrumb",
          "testid": "antdpro-breadcrumb",
          "body": [
            {
              "type": "text",
              "text": "项目中心",
              "className": "adp-breadcrumb-link"
            },
            {
              "type": "text",
              "text": "/"
            },
            {
              "type": "text",
              "text": "订单管理",
              "className": "adp-breadcrumb-link"
            },
            {
              "type": "text",
              "text": "/"
            },
            {
              "type": "text",
              "text": "订单列表"
            }
          ]
        },
        {
          "type": "flex",
          "direction": "row",
          "gap": 8,
          "className": "items-center justify-between mt-2",
          "body": [
            {
              "type": "text",
              "text": "订单列表",
              "className": "adp-page-title",
              "testid": "antdpro-page-title"
            },
            {
              "type": "flex",
              "direction": "row",
              "gap": 8,
              "className": "items-center",
              "body": [
                {
                  "type": "button",
                  "label": "批量导出",
                  "className": "adp-btn adp-btn-outline",
                  "testid": "antdpro-list-export"
                },
                {
                  "type": "button",
                  "label": "新建订单",
                  "className": "adp-btn adp-btn-primary",
                  "testid": "antdpro-list-new",
                  "onClick": {
                    "action": "openDialog",
                    "args": {
                      "title": "新建订单",
                      "testid": "antdpro-new-dialog",
                      "className": "adp-dialog",
                      "closeOnSubmit": true,
                      "onSubmitSuccess": {
                        "action": "component:refresh",
                        "componentId": "antdpro-list-crud"
                      },
                      "body": [
                        {
                          "type": "form",
                          "id": "antdpro-new-form",
                          "testid": "antdpro-new-form",
                          "submitScope": "surface",
                          "submitAction": {
                            "action": "ajax",
                            "args": {
                              "url": "/r/AntdPro__saveOrder",
                              "method": "post",
                              "includeScope": "*"
                            },
                            "messages": {
                              "success": "新建成功"
                            }
                          },
                          "columnCount": 2,
                          "body": [
                            {
                              "type": "input-text",
                              "name": "customer",
                              "label": "客户名称",
                              "required": true,
                              "placeholder": "请输入客户全称",
                              "testid": "antdpro-new-customer"
                            },
                            {
                              "type": "input-number",
                              "name": "amount",
                              "label": "订单金额",
                              "min": 0,
                              "placeholder": "单位：元"
                            },
                            {
                              "type": "select",
                              "name": "channel",
                              "label": "订单渠道",
                              "placeholder": "选择渠道",
                              "options": [
                                {
                                  "label": "官网",
                                  "value": "web"
                                },
                                {
                                  "label": "小程序",
                                  "value": "miniapp"
                                },
                                {
                                  "label": "门店",
                                  "value": "store"
                                },
                                {
                                  "label": "App",
                                  "value": "app"
                                }
                              ]
                            },
                            {
                              "type": "input-text",
                              "name": "owner",
                              "label": "销售负责人",
                              "placeholder": "请输入负责人"
                            }
                          ],
                          "actions": [
                            {
                              "type": "button",
                              "label": "取消",
                              "className": "adp-btn adp-btn-outline",
                              "testid": "antdpro-new-cancel",
                              "onClick": {
                                "action": "closeSurface"
                              }
                            },
                            {
                              "type": "button",
                              "label": "确定",
                              "className": "adp-btn adp-btn-primary",
                              "testid": "antdpro-new-confirm",
                              "onClick": {
                                "action": "submitForm"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "text": "订单数据由模拟后端实时提供，可按关键字、状态与渠道筛选。",
          "className": "adp-desc-label mt-1"
        }
      ]
    },
    {
      "type": "container",
      "className": "adp-card p-4",
      "body": [
        {
          "type": "crud",
          "id": "antdpro-list-crud",
          "testid": "antdpro-list-crud",
          "rowKey": "id",
          "loadAction": {
            "action": "ajax",
            "args": {
              "url": "/r/AntdPro__orders",
              "method": "get",
              "selection": "id,orderNo,customer,channel,channelLabel,payType,amount,amountText,status,statusLabel,owner,createdAt",
              "data": {
                "keyword": "${query.keyword ?? \"\"}",
                "status": "${query.status ?? \"\"}",
                "channel": "${query.channel ?? \"\"}"
              }
            }
          },
          "selection": {},
          "filterTogglable": {
            "defaultCollapsed": false
          },
          "queryForm": {
            "layout": "horizontal",
            "labelWidth": 80,
            "columnCount": 3,
            "gap": "sm",
            "body": [
              {
                "type": "input-text",
                "name": "keyword",
                "label": "关键字",
                "placeholder": "订单号 / 客户名称",
                "testid": "antdpro-query-keyword"
              },
              {
                "type": "select",
                "name": "status",
                "label": "状态",
                "clearable": true,
                "placeholder": "全部状态",
                "options": [
                  {
                    "label": "待付款",
                    "value": "pending"
                  },
                  {
                    "label": "备货中",
                    "value": "processing"
                  },
                  {
                    "label": "配送中",
                    "value": "shipped"
                  },
                  {
                    "label": "已完成",
                    "value": "done"
                  },
                  {
                    "label": "已关闭",
                    "value": "cancelled"
                  }
                ],
                "testid": "antdpro-query-status"
              },
              {
                "type": "select",
                "name": "channel",
                "label": "渠道",
                "clearable": true,
                "placeholder": "全部渠道",
                "options": [
                  {
                    "label": "官网",
                    "value": "web"
                  },
                  {
                    "label": "小程序",
                    "value": "miniapp"
                  },
                  {
                    "label": "门店",
                    "value": "store"
                  },
                  {
                    "label": "App",
                    "value": "app"
                  }
                ],
                "testid": "antdpro-query-channel"
              }
            ]
          },
          "toolbar": [
            {
              "type": "button",
              "label": "刷新",
              "icon": "rotate-cw",
              "variant": "outline",
              "testid": "antdpro-toolbar-refresh",
              "onClick": {
                "action": "component:refresh",
                "componentId": "antdpro-list-crud"
              }
            },
            {
              "type": "button",
              "label": "密度",
              "icon": "rows-3",
              "variant": "outline",
              "testid": "antdpro-toolbar-density"
            },
            {
              "type": "text",
              "text": "已选择 ${$crud.selectionCount} 项",
              "className": "adp-desc-label",
              "visible": "${$crud.hasSelection}",
              "testid": "antdpro-list-selection-count"
            },
            {
              "type": "button",
              "label": "取消选择",
              "variant": "ghost",
              "visible": "${$crud.hasSelection}",
              "testid": "antdpro-list-clear-selection",
              "onClick": {
                "action": "component:clearSelection",
                "componentId": "antdpro-list-crud"
              }
            }
          ],
          "listActions": [
            {
              "type": "button",
              "label": "批量删除",
              "variant": "destructive",
              "testid": "antdpro-list-bulk-delete",
              "disabled": "${!$crud.hasSelection}",
              "onClick": {
                "action": "ajax",
                "args": {
                  "url": "/r/AntdPro__deleteOrders",
                  "method": "post",
                  "data": {
                    "ids": "${$crud.selectedRowKeys}"
                  }
                },
                "messages": {
                  "success": "批量删除成功"
                },
                "then": {
                  "action": "component:refresh",
                  "componentId": "antdpro-list-crud"
                }
              }
            }
          ],
          "columns": [
            {
              "name": "orderNo",
              "label": "订单号",
              "width": 140,
              "sortable": true
            },
            {
              "name": "customer",
              "label": "客户名称",
              "width": 200
            },
            {
              "name": "channelLabel",
              "label": "渠道",
              "width": 90
            },
            {
              "name": "amountText",
              "label": "订单金额",
              "width": 120,
              "align": "right",
              "cell": {
                "type": "text",
                "text": "${amountText}",
                "className": "adp-mono"
              }
            },
            {
              "name": "statusLabel",
              "label": "状态",
              "width": 100,
              "cell": {
                "type": "container",
                "body": [
                  {
                    "type": "text",
                    "text": "${statusLabel}",
                    "className": "adp-tag adp-tag-success",
                    "visible": "${status === 'done'}"
                  },
                  {
                    "type": "text",
                    "text": "${statusLabel}",
                    "className": "adp-tag adp-tag-warning",
                    "visible": "${status === 'pending'}"
                  },
                  {
                    "type": "text",
                    "text": "${statusLabel}",
                    "className": "adp-tag adp-tag-processing",
                    "visible": "${status === 'processing' || status === 'shipped'}"
                  },
                  {
                    "type": "text",
                    "text": "${statusLabel}",
                    "className": "adp-tag adp-tag-default",
                    "visible": "${status === 'cancelled'}"
                  }
                ]
              }
            },
            {
              "name": "owner",
              "label": "销售负责人",
              "width": 110
            },
            {
              "name": "createdAt",
              "label": "下单时间",
              "width": 170,
              "sortable": true
            },
            {
              "type": "operation",
              "label": "操作",
              "fixed": "right",
              "width": 160,
              "buttons": [
                {
                  "type": "button",
                  "label": "查看",
                  "className": "adp-btn-link",
                  "testid": "antdpro-op-view",
                  "onClick": {
                    "action": "ajax",
                    "args": {
                      "url": "/r/AntdPro__selectOrder",
                      "method": "post",
                      "data": {
                        "id": "${id}"
                      }
                    },
                    "then": {
                      "action": "navigate",
                      "args": {
                        "url": "#/complex-pages/antdpro-detail-basic"
                      }
                    }
                  }
                },
                {
                  "type": "button",
                  "label": "编辑",
                  "className": "adp-btn-link",
                  "testid": "antdpro-op-edit",
                  "onClick": {
                    "action": "openDialog",
                    "args": {
                      "title": "编辑订单",
                      "testid": "antdpro-edit-dialog",
                      "className": "adp-dialog",
                      "data": {
                        "id": "${id}",
                        "customer": "${customer}",
                        "amount": "${amount}",
                        "channel": "${channel}",
                        "owner": "${owner}"
                      },
                      "closeOnSubmit": true,
                      "onSubmitSuccess": {
                        "action": "component:refresh",
                        "componentId": "antdpro-list-crud"
                      },
                      "body": [
                        {
                          "type": "form",
                          "id": "antdpro-edit-form",
                          "testid": "antdpro-edit-form",
                          "submitScope": "surface",
                          "data": {
                            "id": "${id}",
                            "customer": "${customer}",
                            "amount": "${amount}",
                            "channel": "${channel}",
                            "owner": "${owner}"
                          },
                          "submitAction": {
                            "action": "ajax",
                            "args": {
                              "url": "/r/AntdPro__saveOrder",
                              "method": "post",
                              "includeScope": "*"
                            },
                            "messages": {
                              "success": "保存成功"
                            }
                          },
                          "columnCount": 2,
                          "body": [
                            {
                              "type": "input-text",
                              "name": "customer",
                              "label": "客户名称",
                              "required": true,
                              "testid": "antdpro-edit-customer"
                            },
                            {
                              "type": "input-number",
                              "name": "amount",
                              "label": "订单金额",
                              "min": 0
                            },
                            {
                              "type": "select",
                              "name": "channel",
                              "label": "订单渠道",
                              "options": [
                                {
                                  "label": "官网",
                                  "value": "web"
                                },
                                {
                                  "label": "小程序",
                                  "value": "miniapp"
                                },
                                {
                                  "label": "门店",
                                  "value": "store"
                                },
                                {
                                  "label": "App",
                                  "value": "app"
                                }
                              ]
                            },
                            {
                              "type": "input-text",
                              "name": "owner",
                              "label": "销售负责人"
                            }
                          ],
                          "actions": [
                            {
                              "type": "button",
                              "label": "取消",
                              "className": "adp-btn adp-btn-outline",
                              "testid": "antdpro-edit-cancel",
                              "onClick": {
                                "action": "closeSurface"
                              }
                            },
                            {
                              "type": "button",
                              "label": "保存",
                              "className": "adp-btn adp-btn-primary",
                              "testid": "antdpro-edit-confirm",
                              "onClick": {
                                "action": "submitForm"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "button",
                  "label": "删除",
                  "className": "adp-btn-danger-link",
                  "testid": "antdpro-op-delete",
                  "onClick": {
                    "action": "openDialog",
                    "args": {
                      "title": "删除确认",
                      "testid": "antdpro-delete-dialog",
                      "className": "adp-dialog",
                      "body": [
                        {
                          "type": "text",
                          "text": "确定删除订单 ${orderNo}（${customer}）吗？删除后不可恢复。",
                          "testid": "antdpro-delete-message"
                        },
                        {
                          "type": "flex",
                          "direction": "row",
                          "gap": 8,
                          "className": "justify-end mt-4",
                          "body": [
                            {
                              "type": "button",
                              "label": "取消",
                              "variant": "outline",
                              "testid": "antdpro-delete-cancel",
                              "onClick": {
                                "action": "closeSurface"
                              }
                            },
                            {
                              "type": "button",
                              "label": "确认删除",
                              "variant": "destructive",
                              "testid": "antdpro-delete-confirm",
                              "onClick": {
                                "action": "ajax",
                                "args": {
                                  "url": "/r/AntdPro__deleteOrders",
                                  "method": "post",
                                  "data": {
                                    "ids": "${id}"
                                  }
                                },
                                "messages": {
                                  "success": "删除成功"
                                },
                                "then": [
                                  {
                                    "action": "closeSurface"
                                  },
                                  {
                                    "action": "component:refresh",
                                    "componentId": "antdpro-list-crud"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "columnSettings": {
            "enabled": true
          },
          "onQuerySubmit": {
            "action": "setValue",
            "args": {
              "path": "$_crud.antdpro-list-crud.pagination",
              "value": {
                "currentPage": 1,
                "pageSize": 10
              }
            }
          }
        }
      ]
    }
  ]
}
