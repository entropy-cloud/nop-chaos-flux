{
  "type": "page",
  "testid": "linear-board-page",
  "className": "ln-root",
  "body": [
    {
      "type": "data-source",
      "name": "board",
      "action": "ajax",
      "args": { "url": "/r/Linear__issues?view=board", "method": "get" }
    },
    {
      "type": "container",
      "testid": "linear-board-main",
      "className": "flex flex-row items-stretch min-h-screen",
      "body": [
        {
          "type": "container",
          "testid": "linear-board-sidebar",
          "className": "w-60 shrink-0 border-r flex flex-col py-3",
          "body": [
            {
              "type": "container",
              "testid": "linear-board-workspace",
              "className": "px-2 pb-2",
              "body": [
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-workspace",
                  "body": [
                    {
                      "type": "container",
                      "className": "ln-avatar ln-avatar-brand",
                      "body": [{ "type": "text", "text": "问" }]
                    },
                    { "type": "text", "text": "问题工作台" },
                    { "type": "icon", "icon": "chevron-down", "size": 14 }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "testid": "linear-board-nav",
              "className": "flex flex-col",
              "body": [
                { "type": "text", "text": "导航", "className": "ln-side-group" },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "inbox", "size": 15 },
                    { "type": "text", "text": "收件箱" },
                    { "type": "text", "text": "4", "className": "ln-row-meta ml-auto" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "user", "size": 15 },
                    { "type": "text", "text": "我的问题" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "layers", "size": 15 },
                    { "type": "text", "text": "活跃问题" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item ln-side-item-active",
                  "body": [
                    { "type": "icon", "icon": "kanban", "size": 15 },
                    { "type": "text", "text": "看板视图" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "repeat", "size": 15 },
                    { "type": "text", "text": "周期" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "folder", "size": 15 },
                    { "type": "text", "text": "项目" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "settings", "size": 15 },
                    { "type": "text", "text": "设置" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "testid": "linear-board-content",
          "className": "flex-1 min-w-0 flex flex-col",
          "body": [
            {
              "type": "container",
              "testid": "linear-board-topbar",
              "className": "h-12 shrink-0 border-b flex items-center gap-2 px-4",
              "body": [
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 4,
                  "className": "items-center",
                  "testid": "linear-board-view-tabs",
                  "body": [
                    {
                      "type": "flex",
                      "direction": "row",
                      "gap": 4,
                      "className": "items-center ln-tab",
                      "testid": "linear-board-tab-list",
                      "onClick": {
                        "action": "navigate",
                        "args": { "url": "#/complex-pages/linear-issues" }
                      },
                      "body": [
                        { "type": "icon", "icon": "list", "size": 14 },
                        { "type": "text", "text": "列表" }
                      ]
                    },
                    {
                      "type": "container",
                      "className": "ln-tab ln-tab-active",
                      "testid": "linear-board-tab-board",
                      "body": [
                        { "type": "icon", "icon": "kanban", "size": 14 },
                        { "type": "text", "text": "看板" }
                      ]
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 6,
                  "className": "items-center ml-auto",
                  "body": [
                    {
                      "type": "flex",
                      "direction": "row",
                      "gap": 6,
                      "className": "items-center ln-topbar-btn",
                      "testid": "linear-board-filter-entry",
                      "body": [
                        { "type": "icon", "icon": "filter", "size": 14 },
                        { "type": "text", "text": "筛选" }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "拖拽重排属交互计划：本页为静态形态，卡片不可拖拽",
                      "className": "ln-row-meta",
                      "testid": "linear-board-dnd-note"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "testid": "linear-board-canvas",
              "className": "ln-board flex-1 min-h-0",
              "body": [
                {
                  "type": "kanban",
                  "testid": "linear-board-kanban",
                  "data": "${board?.board}",
                  "draggable": false,
                  "columnWidth": 280,
                  "empty": { "type": "text", "text": "该状态下暂无问题", "className": "ln-empty" }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
