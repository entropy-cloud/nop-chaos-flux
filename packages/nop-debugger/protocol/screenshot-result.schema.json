{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nop-chaos.dev/schemas/devtools/screenshot-result.schema.json",
  "title": "Flux DevTools ScreenshotResult (frozen v1)",
  "description": "Unified capture result across all capture backends. Design: capture design §2. TS-native Uint8Array bytes are transported as base64 strings (encoding field) — see protocol README mapping table.",
  "type": "object",
  "required": [
    "id",
    "backend",
    "width",
    "height",
    "encoding",
    "bytes",
    "mime",
    "hash",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "backend": { "type": "string", "enum": ["cdp", "foreign-object", "raster-fallback"] },
    "width": { "type": "number", "exclusiveMinimum": 0 },
    "height": { "type": "number", "exclusiveMinimum": 0 },
    "encoding": { "const": "base64" },
    "bytes": { "type": "string", "contentEncoding": "base64" },
    "mime": { "type": "string", "enum": ["image/png", "image/webp", "image/jpeg"] },
    "hash": {
      "type": "string",
      "minLength": 1,
      "description": "Content hash — incremental reuse key"
    },
    "createdAt": { "type": "number" },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch": { "type": "number" },
        "cid": { "type": "string" },
        "interactionId": { "type": "string" },
        "tag": { "type": "string" }
      }
    },
    "degraded": {
      "type": "object",
      "required": ["reasons"],
      "additionalProperties": false,
      "properties": {
        "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
