{
  "type": "page",
  "testid": "linear-issues-page",
  "className": "ln-root",
  "body": [
    {
      "type": "data-source",
      "name": "issues",
      "action": "ajax",
      "args": {
        "url": "/r/Linear__issues?perPage=50",
        "method": "get"
      }
    },
    {
      "type": "data-source",
      "name": "commands",
      "action": "ajax",
      "args": {
        "url": "/r/Linear__commands",
        "method": "get"
      }
    },
    {
      "type": "container",
      "testid": "linear-issues-main",
      "className": "flex flex-row items-stretch min-h-screen",
      "body": [
        {
          "type": "container",
          "testid": "linear-issues-sidebar",
          "className": "w-60 shrink-0 border-r flex flex-col py-3",
          "body": [
            {
              "type": "container",
              "testid": "linear-issues-workspace",
              "className": "px-2 pb-2",
              "body": [
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-workspace",
                  "body": [
                    {
                      "type": "container",
                      "className": "ln-avatar ln-avatar-brand",
                      "testid": "linear-issues-workspace-avatar",
                      "body": [
                        {
                          "type": "text",
                          "text": "问"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "问题工作台"
                    },
                    {
                      "type": "icon",
                      "icon": "chevron-down",
                      "size": 14
                    }
                  ]
                },
                {
                  "type": "container",
                  "testid": "linear-issues-cmdk-trigger",
                  "className": "ln-search-bar mt-2",
                  "onClick": {
                    "action": "openDialog",
                    "args": {
                      "title": "命令面板",
                      "testid": "linear-issues-cmdk",
                      "className": "ln-dialog",
                      "body": [
                        {
                          "type": "container",
                          "testid": "linear-issues-cmdk-body",
                          "className": "w-100 flex flex-col",
                          "body": [
                            {
                              "type": "input-text",
                              "name": "cmdkQuery",
                              "testid": "linear-issues-cmdk-input",
                              "placeholder": "输入命令或搜索问题…",
                              "className": "ln-cmd-input"
                            },
                            {
                              "type": "loop",
                              "testid": "linear-issues-cmdk-groups",
                              "items": "${commands?.groups}",
                              "body": [
                                {
                                  "type": "container",
                                  "testid": "linear-issues-cmdk-group",
                                  "className": "flex flex-col py-1",
                                  "body": [
                                    {
                                      "type": "text",
                                      "text": "${$slot.item.label}",
                                      "className": "ln-cmd-group px-3",
                                      "testid": "linear-issues-cmdk-group-label"
                                    },
                                    {
                                      "type": "loop",
                                      "items": "${$slot.item.items}",
                                      "body": [
                                        {
                                          "type": "flex",
                                          "direction": "row",
                                          "gap": 10,
                                          "className": "items-center ln-cmd-item",
                                          "testid": "linear-issues-cmdk-item",
                                          "body": [
                                            {
                                              "type": "text",
                                              "text": "${$slot.item.label}",
                                              "className": "flex-1"
                                            },
                                            {
                                              "type": "container",
                                              "visible": "${$slot.item.kbd !== undefined}",
                                              "body": [
                                                {
                                                  "type": "text",
                                                  "text": "${$slot.item.kbd}",
                                                  "className": "ln-kbd",
                                                  "testid": "linear-issues-cmdk-kbd"
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "body": [
                    {
                      "type": "icon",
                      "icon": "search",
                      "size": 14
                    },
                    {
                      "type": "text",
                      "text": "搜索或跳转…"
                    },
                    {
                      "type": "flex",
                      "direction": "row",
                      "gap": 2,
                      "className": "items-center ml-auto",
                      "body": [
                        {
                          "type": "text",
                          "text": "⌘",
                          "className": "ln-kbd"
                        },
                        {
                          "type": "text",
                          "text": "K",
                          "className": "ln-kbd"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "testid": "linear-issues-nav",
              "className": "flex flex-col",
              "body": [
                {
                  "type": "text",
                  "text": "导航",
                  "className": "ln-side-group"
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    {
                      "type": "icon",
                      "icon": "inbox",
                      "size": 15
                    },
                    {
                      "type": "text",
                      "text": "收件箱"
                    },
                    {
                      "type": "text",
                      "text": "4",
                      "className": "ln-row-meta ml-auto"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    {
                      "type": "icon",
                      "icon": "user",
                      "size": 15
                    },
                    {
                      "type": "text",
                      "text": "我的问题"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item ln-side-item-active",
                  "body": [
                    {
                      "type": "icon",
                      "icon": "layers",
                      "size": 15
                    },
                    {
                      "type": "text",
                      "text": "活跃问题"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    {
                      "type": "icon",
                      "icon": "kanban",
                      "size": 15
                    },
                    {
                      "type": "text",
                      "text": "看板视图"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    {
                      "type": "icon",
                      "icon": "repeat",
                      "size": 15
                    },
                    {
                      "type": "text",
                      "text": "周期"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    {
                      "type": "icon",
                      "icon": "folder",
                      "size": 15
                    },
                    {
                      "type": "text",
                      "text": "项目"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    {
                      "type": "icon",
                      "icon": "settings",
                      "size": 15
                    },
                    {
                      "type": "text",
                      "text": "设置"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "testid": "linear-issues-fav-group",
              "className": "flex flex-col mt-3",
              "body": [
                {
                  "type": "text",
                  "text": "收藏",
                  "className": "ln-side-group"
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    {
                      "type": "container",
                      "className": "ln-status-dot ln-status-in_progress"
                    },
                    {
                      "type": "text",
                      "text": "平台重构"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    {
                      "type": "container",
                      "className": "ln-status-dot ln-status-done"
                    },
                    {
                      "type": "text",
                      "text": "性能专项"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "testid": "linear-issues-content",
          "className": "flex-1 min-w-0 flex flex-col relative",
          "body": [
            {
              "type": "container",
              "testid": "linear-issues-topbar",
              "className": "h-12 shrink-0 border-b flex items-center gap-2 px-4",
              "body": [
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 4,
                  "className": "items-center",
                  "testid": "linear-issues-view-tabs",
                  "body": [
                    {
                      "type": "container",
                      "className": "ln-tab ln-tab-active",
                      "testid": "linear-issues-tab-list",
                      "body": [
                        {
                          "type": "icon",
                          "icon": "list",
                          "size": 14
                        },
                        {
                          "type": "text",
                          "text": "列表"
                        }
                      ]
                    },
                    {
                      "type": "flex",
                      "direction": "row",
                      "gap": 4,
                      "className": "items-center ln-tab",
                      "testid": "linear-issues-tab-board",
                      "onClick": {
                        "action": "navigate",
                        "args": {
                          "url": "#/complex-pages/linear-board"
                        }
                      },
                      "body": [
                        {
                          "type": "icon",
                          "icon": "kanban",
                          "size": 14
                        },
                        {
                          "type": "text",
                          "text": "看板"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 6,
                  "className": "items-center ml-auto",
                  "body": [
                    {
                      "type": "flex",
                      "direction": "row",
                      "gap": 6,
                      "className": "items-center ln-topbar-btn",
                      "testid": "linear-issues-filter-entry",
                      "body": [
                        {
                          "type": "icon",
                          "icon": "filter",
                          "size": 14
                        },
                        {
                          "type": "text",
                          "text": "筛选"
                        }
                      ]
                    },
                    {
                      "type": "flex",
                      "direction": "row",
                      "gap": 6,
                      "className": "items-center ln-topbar-btn",
                      "testid": "linear-issues-display-trigger",
                      "onClick": {
                        "action": "openDrawer",
                        "args": {
                          "title": "显示选项",
                          "testid": "linear-issues-display-drawer",
                          "className": "ln-dialog",
                          "side": "right",
                          "body": [
                            {
                              "type": "container",
                              "testid": "linear-issues-display-body",
                              "className": "flex flex-col gap-5 p-1",
                              "body": [
                                {
                                  "type": "container",
                                  "className": "flex flex-col gap-2",
                                  "body": [
                                    {
                                      "type": "text",
                                      "text": "分组",
                                      "className": "ln-prop-label"
                                    },
                                    {
                                      "type": "select",
                                      "name": "displayGrouping",
                                      "testid": "linear-issues-display-grouping",
                                      "clearable": false,
                                      "defaultValue": "status",
                                      "options": [
                                        {
                                          "label": "无分组",
                                          "value": "none"
                                        },
                                        {
                                          "label": "按状态",
                                          "value": "status"
                                        },
                                        {
                                          "label": "按指派人",
                                          "value": "assignee"
                                        },
                                        {
                                          "label": "按优先级",
                                          "value": "priority"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "container",
                                  "className": "flex flex-col gap-2",
                                  "body": [
                                    {
                                      "type": "text",
                                      "text": "排序",
                                      "className": "ln-prop-label"
                                    },
                                    {
                                      "type": "select",
                                      "name": "displayOrdering",
                                      "testid": "linear-issues-display-ordering",
                                      "clearable": false,
                                      "defaultValue": "manual",
                                      "options": [
                                        {
                                          "label": "手动（支持键盘重排）",
                                          "value": "manual"
                                        },
                                        {
                                          "label": "按优先级",
                                          "value": "priority"
                                        },
                                        {
                                          "label": "按更新时间",
                                          "value": "updated"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "container",
                                  "testid": "linear-issues-display-manual-note",
                                  "className": "ln-reschedule-note",
                                  "body": [
                                    {
                                      "type": "text",
                                      "text": "手动排序为键盘重排（⌥↑↓ / ⌥⇧↑↓）的前置条件：分组需为「无分组」且排序为「手动」。键盘重排接线属后续交互计划。",
                                      "className": "ln-row-meta"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      },
                      "body": [
                        {
                          "type": "icon",
                          "icon": "sliders-horizontal",
                          "size": 14
                        },
                        {
                          "type": "text",
                          "text": "显示"
                        }
                      ]
                    },
                    {
                      "type": "flex",
                      "direction": "row",
                      "gap": 6,
                      "className": "items-center ln-btn ln-btn-primary h-7 px-3 text-xs",
                      "testid": "linear-issues-cmdk-button",
                      "onClick": {
                        "action": "openDialog",
                        "args": {
                          "title": "命令面板",
                          "testid": "linear-issues-cmdk",
                          "className": "ln-dialog",
                          "body": [
                            {
                              "type": "text",
                              "text": "输入命令或搜索问题…",
                              "className": "ln-cmd-group"
                            },
                            {
                              "type": "loop",
                              "items": "${commands?.groups}",
                              "body": [
                                {
                                  "type": "container",
                                  "className": "flex flex-col py-1",
                                  "body": [
                                    {
                                      "type": "text",
                                      "text": "${$slot.item.label}",
                                      "className": "ln-cmd-group px-3"
                                    },
                                    {
                                      "type": "loop",
                                      "items": "${$slot.item.items}",
                                      "body": [
                                        {
                                          "type": "flex",
                                          "direction": "row",
                                          "gap": 10,
                                          "className": "items-center ln-cmd-item",
                                          "body": [
                                            {
                                              "type": "text",
                                              "text": "${$slot.item.label}",
                                              "className": "flex-1"
                                            },
                                            {
                                              "type": "container",
                                              "visible": "${$slot.item.kbd !== undefined}",
                                              "body": [
                                                {
                                                  "type": "text",
                                                  "text": "${$slot.item.kbd}",
                                                  "className": "ln-kbd"
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      },
                      "body": [
                        {
                          "type": "icon",
                          "icon": "command",
                          "size": 13
                        },
                        {
                          "type": "text",
                          "text": "命令"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "table",
              "testid": "linear-issues-table",
              "className": "ln-issues-table flex-1",
              "source": "${issues?.items}",
              "rowKey": "id",
              "pagination": {
                "enabled": true,
                "pageSize": 10
              },
              "empty": {
                "type": "text",
                "text": "当前筛选条件下没有问题",
                "className": "ln-empty"
              },
              "columns": [
                {
                  "name": "check",
                  "label": "",
                  "width": 44,
                  "cell": {
                    "type": "container",
                    "className": "flex items-center justify-center",
                    "body": [
                      {
                        "type": "container",
                        "visible": "${id !== 'ENG-105'}",
                        "className": "ln-row-check",
                        "testid": "linear-issues-row-check"
                      },
                      {
                        "type": "container",
                        "visible": "${id === 'ENG-105'}",
                        "className": "ln-row-check ln-row-check-on",
                        "testid": "linear-issues-row-check-on",
                        "body": [
                          {
                            "type": "text",
                            "text": "✓"
                          }
                        ]
                      }
                    ]
                  }
                },
                {
                  "name": "status",
                  "label": "状态",
                  "width": 110,
                  "cell": {
                    "type": "container",
                    "className": "flex items-center gap-2",
                    "body": [
                      {
                        "type": "container",
                        "className": "${statusDotClass}",
                        "testid": "linear-issues-status-dot"
                      },
                      {
                        "type": "text",
                        "text": "${statusLabel}",
                        "className": "ln-row-meta"
                      }
                    ]
                  }
                },
                {
                  "name": "title",
                  "label": "问题",
                  "cell": {
                    "type": "container",
                    "className": "flex items-center gap-3 min-w-0",
                    "body": [
                      {
                        "type": "text",
                        "text": "${id}",
                        "className": "ln-row-key ln-mono shrink-0",
                        "testid": "linear-issues-row-key"
                      },
                      {
                        "type": "text",
                        "text": "${title}",
                        "className": "ln-row-title flex-1 min-w-0",
                        "testid": "linear-issues-row-title"
                      }
                    ]
                  }
                },
                {
                  "name": "labels",
                  "label": "标签",
                  "width": 150,
                  "cell": {
                    "type": "container",
                    "className": "flex items-center gap-1 flex-wrap",
                    "body": [
                      {
                        "type": "loop",
                        "items": "${labels}",
                        "body": [
                          {
                            "type": "text",
                            "text": "${$slot.item}",
                            "className": "ln-label-pill",
                            "testid": "linear-issues-label-pill"
                          }
                        ]
                      }
                    ]
                  }
                },
                {
                  "name": "priority",
                  "label": "优先级",
                  "width": 76,
                  "cell": {
                    "type": "container",
                    "className": "${prioClass}",
                    "testid": "linear-issues-prio",
                    "body": [
                      {
                        "type": "container",
                        "className": "ln-prio-bar"
                      },
                      {
                        "type": "container",
                        "className": "ln-prio-bar"
                      },
                      {
                        "type": "container",
                        "className": "ln-prio-bar"
                      }
                    ]
                  }
                },
                {
                  "name": "assignee",
                  "label": "指派",
                  "width": 64,
                  "cell": {
                    "type": "container",
                    "className": "ln-avatar ln-avatar-sm",
                    "testid": "linear-issues-assignee",
                    "body": [
                      {
                        "type": "text",
                        "text": "${assigneeInitials}"
                      }
                    ]
                  }
                },
                {
                  "name": "dueDate",
                  "label": "截止",
                  "width": 96,
                  "cell": {
                    "type": "text",
                    "text": "${dueDate === '' ? '—' : dueDate}",
                    "className": "ln-row-meta",
                    "testid": "linear-issues-due"
                  }
                },
                {
                  "name": "ops",
                  "label": "",
                  "width": 76,
                  "cell": {
                    "type": "button",
                    "label": "打开",
                    "className": "ln-btn ln-btn-ghost h-6 px-2 text-xs",
                    "testid": "linear-issues-peek-trigger",
                    "onClick": {
                      "action": "openDialog",
                      "args": {
                        "title": "问题预览",
                        "testid": "linear-issues-peek",
                        "className": "ln-dialog",
                        "data": {
                          "id": "${id}"
                        },
                        "body": [
                          {
                            "type": "form",
                            "testid": "linear-issues-peek-form",
                            "loadAction": {
                              "action": "ajax",
                              "args": {
                                "url": "/r/Linear__issue?id=${id}",
                                "method": "get"
                              }
                            },
                            "body": [
                              {
                                "type": "container",
                                "testid": "linear-issues-peek-body",
                                "className": "flex flex-row gap-4 min-w-100",
                                "body": [
                                  {
                                    "type": "container",
                                    "className": "flex-1 min-w-0 flex flex-col gap-3",
                                    "body": [
                                      {
                                        "type": "flex",
                                        "direction": "row",
                                        "gap": 8,
                                        "className": "items-center",
                                        "body": [
                                          {
                                            "type": "text",
                                            "text": "${id}",
                                            "className": "ln-row-key ln-mono",
                                            "testid": "linear-issues-peek-key"
                                          },
                                          {
                                            "type": "text",
                                            "text": "${statusLabel}",
                                            "className": "${statusPillClass}",
                                            "testid": "linear-issues-peek-status"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "text",
                                        "text": "${title}",
                                        "className": "ln-detail-title",
                                        "testid": "linear-issues-peek-title"
                                      },
                                      {
                                        "type": "container",
                                        "className": "flex flex-col gap-2",
                                        "testid": "linear-issues-peek-desc",
                                        "body": [
                                          {
                                            "type": "loop",
                                            "items": "${description}",
                                            "body": [
                                              {
                                                "type": "text",
                                                "text": "${$slot.item}",
                                                "className": "ln-desc-block"
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "type": "container",
                                    "className": "w-44 shrink-0 border-l pl-4 flex flex-col gap-3",
                                    "testid": "linear-issues-peek-props",
                                    "body": [
                                      {
                                        "type": "container",
                                        "className": "flex items-center justify-between",
                                        "body": [
                                          {
                                            "type": "text",
                                            "text": "优先级",
                                            "className": "ln-prop-label"
                                          },
                                          {
                                            "type": "text",
                                            "text": "${priorityLabel}",
                                            "className": "${priorityPillClass}"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "container",
                                        "className": "flex items-center justify-between",
                                        "body": [
                                          {
                                            "type": "text",
                                            "text": "指派",
                                            "className": "ln-prop-label"
                                          },
                                          {
                                            "type": "flex",
                                            "direction": "row",
                                            "gap": 6,
                                            "className": "items-center",
                                            "body": [
                                              {
                                                "type": "container",
                                                "className": "ln-avatar ln-avatar-sm",
                                                "body": [
                                                  {
                                                    "type": "text",
                                                    "text": "${assigneeInitials}"
                                                  }
                                                ]
                                              },
                                              {
                                                "type": "text",
                                                "text": "${assignee?.name}",
                                                "className": "ln-prop-value"
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "type": "container",
                                        "className": "flex items-center justify-between",
                                        "body": [
                                          {
                                            "type": "text",
                                            "text": "周期",
                                            "className": "ln-prop-label"
                                          },
                                          {
                                            "type": "text",
                                            "text": "${cycle === '' ? '—' : cycle}",
                                            "className": "ln-prop-value"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "container",
                                        "className": "flex items-center justify-between",
                                        "body": [
                                          {
                                            "type": "text",
                                            "text": "项目",
                                            "className": "ln-prop-label"
                                          },
                                          {
                                            "type": "text",
                                            "text": "${project === '' ? '—' : project}",
                                            "className": "ln-prop-value"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "container",
              "testid": "linear-issues-bulk-bar",
              "className": "ln-bulk-bar",
              "body": [
                {
                  "type": "text",
                  "text": "已选 3 项",
                  "className": "ln-bulk-count",
                  "testid": "linear-issues-bulk-count"
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 6,
                  "className": "items-center",
                  "body": [
                    {
                      "type": "button",
                      "label": "状态",
                      "className": "ln-btn ln-btn-quiet h-7 px-3 text-xs",
                      "testid": "linear-issues-bulk-status"
                    },
                    {
                      "type": "button",
                      "label": "优先级",
                      "className": "ln-btn ln-btn-quiet h-7 px-3 text-xs",
                      "testid": "linear-issues-bulk-priority"
                    },
                    {
                      "type": "button",
                      "label": "指派",
                      "className": "ln-btn ln-btn-quiet h-7 px-3 text-xs",
                      "testid": "linear-issues-bulk-assignee"
                    },
                    {
                      "type": "button",
                      "label": "标签",
                      "className": "ln-btn ln-btn-quiet h-7 px-3 text-xs",
                      "testid": "linear-issues-bulk-label"
                    },
                    {
                      "type": "button",
                      "label": "取消选择",
                      "className": "ln-btn ln-btn-ghost h-7 px-3 text-xs",
                      "testid": "linear-issues-bulk-clear"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
