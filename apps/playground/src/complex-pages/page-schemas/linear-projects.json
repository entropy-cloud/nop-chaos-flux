{
  "type": "page",
  "testid": "linear-projects-page",
  "className": "ln-root",
  "body": [
    {
      "type": "data-source",
      "name": "projects",
      "action": "ajax",
      "args": { "url": "/r/Linear__projects", "method": "get" }
    },
    {
      "type": "container",
      "testid": "linear-projects-main",
      "className": "flex flex-row items-stretch min-h-screen",
      "body": [
        {
          "type": "container",
          "testid": "linear-projects-sidebar",
          "className": "w-60 shrink-0 border-r flex flex-col py-3",
          "body": [
            {
              "type": "container",
              "className": "px-2 pb-2",
              "body": [
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-workspace",
                  "body": [
                    {
                      "type": "container",
                      "className": "ln-avatar ln-avatar-brand",
                      "body": [{ "type": "text", "text": "问" }]
                    },
                    { "type": "text", "text": "问题工作台" },
                    { "type": "icon", "icon": "chevron-down", "size": 14 }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "testid": "linear-projects-nav",
              "className": "flex flex-col",
              "body": [
                { "type": "text", "text": "导航", "className": "ln-side-group" },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "inbox", "size": 15 },
                    { "type": "text", "text": "收件箱" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "layers", "size": 15 },
                    { "type": "text", "text": "活跃问题" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "kanban", "size": 15 },
                    { "type": "text", "text": "看板视图" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "repeat", "size": 15 },
                    { "type": "text", "text": "周期" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item ln-side-item-active",
                  "body": [
                    { "type": "icon", "icon": "folder", "size": 15 },
                    { "type": "text", "text": "项目" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "settings", "size": 15 },
                    { "type": "text", "text": "设置" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "testid": "linear-projects-content",
          "className": "flex-1 min-w-0 flex flex-col",
          "body": [
            {
              "type": "container",
              "testid": "linear-projects-topbar",
              "className": "h-12 shrink-0 border-b flex items-center gap-3 px-6",
              "body": [
                {
                  "type": "text",
                  "text": "项目与周期",
                  "className": "ln-detail-title",
                  "testid": "linear-projects-title"
                },
                {
                  "type": "text",
                  "text": "${projects?.total} 个项目",
                  "className": "ln-row-meta",
                  "testid": "linear-projects-count"
                }
              ]
            },
            {
              "type": "container",
              "testid": "linear-projects-list",
              "className": "flex-1 min-w-0 overflow-y-auto px-6 py-6 flex flex-col gap-5",
              "body": [
                {
                  "type": "loop",
                  "items": "${projects?.items}",
                  "body": [
                    {
                      "type": "container",
                      "testid": "linear-projects-card",
                      "className": "ln-card p-4 flex flex-col gap-3",
                      "body": [
                        {
                          "type": "flex",
                          "direction": "row",
                          "gap": 10,
                          "className": "items-center",
                          "body": [
                            {
                              "type": "text",
                              "text": "${$slot.item.name}",
                              "className": "ln-detail-title",
                              "testid": "linear-projects-card-name"
                            },
                            {
                              "type": "text",
                              "text": "${$slot.item.statusLabel}",
                              "className": "${$slot.item.statusPillClass}",
                              "testid": "linear-projects-card-status"
                            },
                            {
                              "type": "text",
                              "text": "${$slot.item.cycleWindow}",
                              "className": "ln-row-meta ml-auto"
                            }
                          ]
                        },
                        {
                          "type": "flex",
                          "direction": "row",
                          "gap": 8,
                          "className": "items-center",
                          "body": [
                            {
                              "type": "container",
                              "className": "ln-avatar ln-avatar-sm",
                              "testid": "linear-projects-card-lead",
                              "body": [{ "type": "text", "text": "${$slot.item.lead?.initials}" }]
                            },
                            {
                              "type": "text",
                              "text": "${$slot.item.lead?.name}",
                              "className": "ln-prop-value"
                            },
                            {
                              "type": "text",
                              "text": "${$slot.item.summary}",
                              "className": "ln-row-meta",
                              "testid": "linear-projects-card-summary"
                            }
                          ]
                        },
                        {
                          "type": "container",
                          "className": "ln-progress",
                          "testid": "linear-projects-card-progress",
                          "body": [
                            {
                              "type": "container",
                              "className": "ln-progress-track",
                              "body": [
                                {
                                  "type": "container",
                                  "className": "ln-progress-fill ${$slot.item.progressClass}",
                                  "testid": "linear-projects-card-progress-fill"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": "${$slot.item.progressText}",
                              "className": "ln-progress-text"
                            }
                          ]
                        },
                        {
                          "type": "container",
                          "testid": "linear-projects-cycles",
                          "className": "flex flex-col gap-2 border-t pt-3",
                          "body": [
                            { "type": "text", "text": "周期概览", "className": "ln-prop-label" },
                            {
                              "type": "loop",
                              "items": "${$slot.item.cycles}",
                              "body": [
                                {
                                  "type": "flex",
                                  "direction": "row",
                                  "gap": 10,
                                  "className": "items-center ln-sub-issue-row",
                                  "testid": "linear-projects-cycle",
                                  "body": [
                                    {
                                      "type": "text",
                                      "text": "${$slot.item.name}",
                                      "className": "ln-prop-value",
                                      "testid": "linear-projects-cycle-name"
                                    },
                                    {
                                      "type": "text",
                                      "text": "${$slot.item.window}",
                                      "className": "ln-row-meta",
                                      "testid": "linear-projects-cycle-window"
                                    },
                                    {
                                      "type": "container",
                                      "className": "ln-progress flex-1 max-w-40",
                                      "body": [
                                        {
                                          "type": "container",
                                          "className": "ln-progress-track",
                                          "body": [
                                            {
                                              "type": "container",
                                              "className": "ln-progress-fill ${$slot.item.progressClass}",
                                              "testid": "linear-projects-cycle-progress-fill"
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": "${$slot.item.progressText}",
                                      "className": "ln-progress-text",
                                      "testid": "linear-projects-cycle-progress"
                                    },
                                    {
                                      "type": "text",
                                      "text": "${$slot.item.statusLabel}",
                                      "className": "${$slot.item.statusPillClass}",
                                      "testid": "linear-projects-cycle-status"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
