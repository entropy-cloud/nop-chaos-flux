{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nop-chaos.org/schemas/three-canvas.json",
  "title": "Three.js Canvas Schema",
  "description": "Three.js 3D scene config for AI generation and data-driven rendering. Source of truth: packages/flux-renderers-3d/src/schemas.ts. ModelConfig source discipline: url XOR primitive preferred, but dual-source is tolerated at render time (primitive takes precedence) — validators must only reject dual-empty.",
  "type": "object",
  "required": ["type", "scene"],
  "properties": {
    "type": {
      "const": "three-canvas"
    },
    "scene": {
      "$ref": "#/definitions/ThreeSceneConfig"
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DataBinding"
      }
    },
    "events": {
      "type": "object"
    },
    "loading": {},
    "empty": {}
  },
  "definitions": {
    "ThreeSceneConfig": {
      "type": "object",
      "required": ["camera", "lights"],
      "properties": {
        "camera": {
          "type": "object",
          "required": ["position"],
          "properties": {
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "fov": {
              "type": "number",
              "minimum": 1,
              "maximum": 180
            },
            "near": {
              "type": "number",
              "minimum": 0
            },
            "far": {
              "type": "number",
              "minimum": 0
            },
            "controls": {
              "type": "object",
              "properties": {
                "autoRotate": {
                  "type": "boolean"
                },
                "autoRotateSpeed": {
                  "type": "number"
                },
                "minDistance": {
                  "type": "number",
                  "minimum": 0
                },
                "maxDistance": {
                  "type": "number",
                  "minimum": 0
                },
                "maxPolarAngle": {
                  "type": "number",
                  "minimum": 0
                },
                "enablePan": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "lights": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LightConfig"
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string"
            },
            "fog": {
              "type": "object",
              "required": ["color", "near", "far"],
              "properties": {
                "color": {
                  "type": "string"
                },
                "near": {
                  "type": "number"
                },
                "far": {
                  "type": "number"
                }
              }
            },
            "toneMapping": {
              "enum": ["none", "aces", "reinhard"]
            }
          }
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelConfig"
          }
        },
        "json": {
          "description": "three.js native SceneJSON (Object3D.toJSON); rendered via ObjectLoader; bindings address objects by name."
        },
        "interactiveObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "anyOf": [
        {
          "required": ["models"]
        },
        {
          "required": ["json"]
        }
      ]
    },
    "ModelConfig": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "url": {
          "type": "string",
          "description": "GLTF/GLB asset. XOR primitive preferred; dual-source tolerated (primitive wins)."
        },
        "primitive": {
          "$ref": "#/definitions/PrimitiveModelConfig"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "interactive": {
          "type": "boolean"
        },
        "initialAnimation": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "labelOffset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "castShadow": {
          "type": "boolean"
        },
        "receiveShadow": {
          "type": "boolean"
        }
      },
      "description": "Source discipline: url XOR primitive preferred; dual-empty is invalid, dual-source tolerated with primitive precedence."
    },
    "PrimitiveModelConfig": {
      "type": "object",
      "required": ["geometry"],
      "properties": {
        "geometry": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "enum": ["box", "sphere", "cylinder", "plane", "cone", "torus", "tube", "capsule"]
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "path": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "description": "tube path control points"
            }
          }
        },
        "material": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["standard", "basic", "lambert", "phong"]
            },
            "color": {
              "type": "string"
            },
            "opacity": {
              "type": "number"
            },
            "transparent": {
              "type": "boolean"
            },
            "wireframe": {
              "type": "boolean"
            },
            "flatShading": {
              "type": "boolean"
            },
            "metalness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "emissive": {
              "type": "string"
            },
            "emissiveIntensity": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "LightConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["ambient", "directional", "point", "spot", "hemisphere"]
        },
        "color": {
          "type": "string"
        },
        "intensity": {
          "type": "number"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "groundColor": {
          "type": "string"
        },
        "castShadow": {
          "type": "boolean"
        }
      }
    },
    "DataBinding": {
      "type": "object",
      "required": ["id", "target", "source"],
      "properties": {
        "id": {
          "type": "string"
        },
        "target": {
          "type": "object",
          "required": ["modelId", "path", "type"],
          "properties": {
            "modelId": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "enum": ["position", "rotation", "scale", "material", "visible", "custom"]
            }
          }
        },
        "source": {
          "type": "object",
          "required": ["expression"],
          "properties": {
            "expression": {
              "type": "string",
              "description": "Flux ${expr} syntax"
            },
            "scope": {
              "type": "string"
            }
          }
        },
        "transform": {
          "type": "object",
          "properties": {
            "convert": {
              "type": "string"
            },
            "range": {
              "type": "object",
              "required": ["input", "output"],
              "properties": {
                "input": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "output": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "condition": {
          "type": "object",
          "required": ["expression", "trueValue", "falseValue"],
          "properties": {
            "expression": {
              "type": "string"
            },
            "trueValue": {},
            "falseValue": {}
          }
        }
      }
    }
  }
}
