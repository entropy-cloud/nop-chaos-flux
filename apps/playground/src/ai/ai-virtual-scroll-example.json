{
  "type": "page",
  "xui:imports": [{ "from": "ai", "as": "ai" }],
  "body": [
    {
      "type": "ai-chat",
      "testid": "ai-virtual-chat",
      "connector": "${$ai.connectors.mock}",
      "initialMessages": "${messages}",
      "placeholder": "1000 messages seeded — virtual scrolling windowed rendering",
      "submitType": "enter",
      "header": {
        "type": "hstack",
        "className": "p-3 border-b items-center justify-between",
        "items": [
          { "type": "text", "text": "AI Virtual Scroll (A-8)" },
          {
            "type": "text",
            "text": "1000 seeded messages; only the viewport window is in the DOM",
            "className": "text-xs text-muted-foreground"
          }
        ]
      },
      "className": "flex flex-col h-[70vh] max-w-3xl mx-auto p-4 gap-3"
    }
  ]
}
