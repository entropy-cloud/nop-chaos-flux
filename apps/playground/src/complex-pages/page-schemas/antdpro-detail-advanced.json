                },
                {
                  "type": "table",
                  "testid": "antdpro-detail-timeline-table",
                  "source": "${detail?.timeline}",
                  "itemKey": "time",
                  "pagination": {
                    "enabled": false
                  },
                  "empty": {
                    "type": "text",
                    "text": "暂无流转记录"
                  },
                  "columns": [
                    {
                      "name": "time",
                      "label": "时间",
                      "width": 180
                    },
                    {
                      "name": "action",
                      "label": "动作",
                      "width": 200
                    },
                    {
                      "name": "operator",
                      "label": "操作人",
                      "width": 140
                    }
                  ]
                }
              ]
