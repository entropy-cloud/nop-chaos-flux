{
  "name": "@nop-chaos/nop-debugger-ai",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./panel": {
      "types": "./dist/panel/index.d.ts",
      "default": "./dist/panel/index.js"
    }
  },
  "dependencies": {
    "@nop-chaos/flux-renderers-ai": "workspace:*",
    "@nop-chaos/nop-debugger": "workspace:*",
    "@nop-chaos/flux-i18n": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx --cache --cache-location node_modules/.cache/eslint"
  },
  "description": "AI copilot tool surface for the Flux debugger automation API (read-only whitelist adapter)",
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
