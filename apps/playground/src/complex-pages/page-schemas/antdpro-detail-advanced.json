              "type": "text",
              "text": "审批人",
              "className": "adp-desc-label w-24 shrink-0"
            },
            {
              "type": "text",
              "text": "${detail?.approval?.approver ?? '-'}",
              "className": "adp-desc-value",
              "testid": "antdpro-detail-advanced-timeline-approver"
            }
          ]
        },
        {
          "type": "flex",
          "direction": "row",
          "gap": 8,
          "className": "adp-desc-divider py-2.5",
          "body": [
            {
              "type": "text",
              "text": "审批意见",
              "className": "adp-desc-label w-24 shrink-0"
            },
            {
              "type": "text",
              "text": "${detail?.approval?.comment ?? '-'}",
              "className": "adp-desc-value"
            }
          ]
        },
        {
          "type": "loop",
          "items": "${detail?.timeline}",
          "body": [
            {
              "type": "container",
              "className": "adp-timeline-item",
              "testid": "antdpro-detail-advanced-timeline-item",
              "body": [
                {
                  "type": "container",
                  "className": "adp-timeline-dot"
                },
                {
                  "type": "container",
                  "className": "flex flex-col gap-1",
                  "body": [
                    {
                      "type": "flex",
                      "direction": "row",
                      "gap": 8,
                      "className": "items-center",
                      "body": [
                        {
                          "type": "text",
                          "text": "${$slot.item.action}",
                          "className": "adp-timeline-action",
                          "testid": "antdpro-detail-advanced-timeline-action"
                        },
                        {
                          "type": "text",
                          "text": "${$slot.item.operator}",
                          "className": "adp-timeline-operator"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "${$slot.item.time}",
                      "className": "adp-timeline-time"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
