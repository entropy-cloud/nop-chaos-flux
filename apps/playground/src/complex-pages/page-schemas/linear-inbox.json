{
  "type": "page",
  "testid": "linear-inbox-page",
  "className": "ln-root",
  "body": [
    {
      "type": "data-source",
      "name": "inbox",
      "action": "ajax",
      "args": { "url": "/r/Linear__inbox", "method": "get" }
    },
    {
      "type": "container",
      "testid": "linear-inbox-main",
      "className": "flex flex-row items-stretch min-h-screen",
      "body": [
        {
          "type": "container",
          "testid": "linear-inbox-sidebar",
          "className": "w-60 shrink-0 border-r flex flex-col py-3",
          "body": [
            {
              "type": "container",
              "className": "px-2 pb-2",
              "body": [
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-workspace",
                  "body": [
                    {
                      "type": "container",
                      "className": "ln-avatar ln-avatar-brand",
                      "body": [{ "type": "text", "text": "问" }]
                    },
                    { "type": "text", "text": "问题工作台" },
                    { "type": "icon", "icon": "chevron-down", "size": 14 }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "testid": "linear-inbox-nav",
              "className": "flex flex-col",
              "body": [
                { "type": "text", "text": "导航", "className": "ln-side-group" },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item ln-side-item-active",
                  "body": [
                    { "type": "icon", "icon": "inbox", "size": 15 },
                    { "type": "text", "text": "收件箱" },
                    {
                      "type": "text",
                      "text": "${inbox?.unreadCount}",
                      "className": "ln-row-meta ml-auto",
                      "testid": "linear-inbox-nav-unread"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "user", "size": 15 },
                    { "type": "text", "text": "我的问题" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "layers", "size": 15 },
                    { "type": "text", "text": "活跃问题" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "kanban", "size": 15 },
                    { "type": "text", "text": "看板视图" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "repeat", "size": 15 },
                    { "type": "text", "text": "周期" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "folder", "size": 15 },
                    { "type": "text", "text": "项目" }
                  ]
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 8,
                  "className": "items-center ln-side-item",
                  "body": [
                    { "type": "icon", "icon": "settings", "size": 15 },
                    { "type": "text", "text": "设置" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "testid": "linear-inbox-content",
          "className": "flex-1 min-w-0 flex flex-col",
          "body": [
            {
              "type": "container",
              "testid": "linear-inbox-topbar",
              "className": "h-12 shrink-0 border-b flex items-center gap-3 px-4",
              "body": [
                {
                  "type": "text",
                  "text": "收件箱",
                  "className": "ln-detail-title",
                  "testid": "linear-inbox-title"
                },
                {
                  "type": "text",
                  "text": "${inbox?.unreadCount} 条未读",
                  "className": "ln-pill ln-pill-in_progress",
                  "testid": "linear-inbox-unread-pill"
                },
                {
                  "type": "flex",
                  "direction": "row",
                  "gap": 6,
                  "className": "items-center ml-auto",
                  "testid": "linear-inbox-bulk",
                  "body": [
                    {
                      "type": "button",
                      "label": "全部标为已读",
                      "className": "ln-btn ln-btn-quiet h-7 px-3 text-xs",
                      "testid": "linear-inbox-bulk-read"
                    },
                    {
                      "type": "button",
                      "label": "归档所选",
                      "className": "ln-btn ln-btn-ghost h-7 px-3 text-xs",
                      "testid": "linear-inbox-bulk-archive"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "testid": "linear-inbox-groups",
              "className": "flex-1 min-w-0 overflow-y-auto",
              "body": [
                {
                  "type": "loop",
                  "testid": "linear-inbox-group",
                  "items": "${inbox?.groups}",
                  "body": [
                    {
                      "type": "container",
                      "testid": "linear-inbox-group-block",
                      "className": "flex flex-col",
                      "body": [
                        {
                          "type": "flex",
                          "direction": "row",
                          "gap": 8,
                          "className": "items-center px-4 pt-4 pb-1",
                          "body": [
                            {
                              "type": "text",
                              "text": "${$slot.item.label}",
                              "className": "ln-cmd-group",
                              "testid": "linear-inbox-group-label"
                            },
                            {
                              "type": "text",
                              "text": "${$slot.item.items?.length} 条",
                              "className": "ln-row-meta"
                            }
                          ]
                        },
                        {
                          "type": "loop",
                          "items": "${$slot.item.items}",
                          "body": [
                            {
                              "type": "container",
                              "testid": "linear-inbox-item",
                              "className": "ln-notif-row",
                              "body": [
                                {
                                  "type": "container",
                                  "visible": "${$slot.item.unread === true}",
                                  "className": "ln-notif-unread-dot",
                                  "testid": "linear-inbox-item-dot"
                                },
                                {
                                  "type": "container",
                                  "className": "ln-avatar ln-avatar-sm mt-0.5",
                                  "testid": "linear-inbox-item-avatar",
                                  "body": [{ "type": "text", "text": "通" }]
                                },
                                {
                                  "type": "container",
                                  "className": "flex-1 min-w-0 flex flex-col gap-0.5",
                                  "body": [
                                    {
                                      "type": "flex",
                                      "direction": "row",
                                      "gap": 8,
                                      "className": "items-center",
                                      "body": [
                                        {
                                          "type": "text",
                                          "text": "${$slot.item.kindLabel}",
                                          "className": "ln-row-meta",
                                          "testid": "linear-inbox-item-kind"
                                        },
                                        {
                                          "type": "text",
                                          "text": "${$slot.item.issueKey}",
                                          "className": "ln-row-key ln-mono"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": "${$slot.item.title}",
                                      "className": "ln-notif-title",
                                      "testid": "linear-inbox-item-title"
                                    },
                                    {
                                      "type": "text",
                                      "text": "${$slot.item.excerpt}",
                                      "className": "ln-notif-excerpt",
                                      "testid": "linear-inbox-item-excerpt"
                                    }
                                  ]
                                },
                                {
                                  "type": "container",
                                  "className": "flex flex-col items-end gap-1.5 shrink-0",
                                  "body": [
                                    {
                                      "type": "text",
                                      "text": "${$slot.item.time}",
                                      "className": "ln-row-meta",
                                      "testid": "linear-inbox-item-time"
                                    },
                                    {
                                      "type": "button",
                                      "label": "已读归档",
                                      "className": "ln-btn ln-btn-ghost h-6 px-2 text-xs",
                                      "testid": "linear-inbox-item-archive"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
