{
  "type": "designer-page",
  "xui:imports": [
    {
      "from": "taskflow-designer",
      "as": "taskflow"
    }
  ],
  "treeDocument": {
    "id": "tf-dingflow-demo",
    "kind": "nop-taskflow-dingflow",
    "name": "TaskFlow DingFlow Demo",
    "version": "1.0",
    "meta": {
      "syntheticRootId": "__synthetic_root__"
    },
    "root": {
      "id": "__synthetic_root__",
      "type": "tf-entry",
      "data": {},
      "child": {
        "id": "seq-1",
        "type": "tf-sequential",
        "data": {
          "step": {
            "id": "seq-1",
            "type": "sequential",
            "common": {
              "name": "initSequence"
            },
            "props": {
              "type": "sequential"
            }
          }
        },
        "child": {
          "id": "script-1",
          "type": "tf-script",
          "data": {
            "step": {
              "id": "script-1",
              "type": "script",
              "common": {
                "name": "loadData"
              },
              "props": {
                "type": "script",
                "lang": "js"
              }
            }
          },
          "child": {
            "id": "if-1",
            "type": "tf-if",
            "data": {
              "step": {
                "id": "if-1",
                "type": "if",
                "common": {
                  "name": "checkCondition"
                },
                "props": {
                  "type": "if",
                  "condition": "true"
                }
              }
            },
            "branches": [
              {
                "id": "then-1",
                "data": {
                  "branchType": "then",
                  "label": "Valid"
                },
                "child": {
                  "id": "invoke-1",
                  "type": "tf-invoke",
                  "data": {
                    "step": {
                      "id": "invoke-1",
                      "type": "invoke",
                      "common": {
                        "name": "processValid"
                      },
                      "props": {
                        "type": "invoke",
                        "bean": "processor",
                        "method": "handle"
                      }
                    }
                  }
                }
              },
              {
                "id": "else-1",
                "data": {
                  "branchType": "else",
                  "label": "Invalid"
                },
                "child": {
                  "id": "script-2",
                  "type": "tf-script",
                  "data": {
                    "step": {
                      "id": "script-2",
                      "type": "script",
                      "common": {
                        "name": "handleInvalid"
                      },
                      "props": {
                        "type": "script",
                        "lang": "js"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "config": {
    "version": "1.1.0",
    "kind": "nop-taskflow-dingflow",
    "documentMode": "tree",
    "treeConfig": {
      "layout": {
        "direction": "TB",
        "nodeSpacing": 60,
        "layerSpacing": 100
      },
      "showGatewayNodes": true,
      "showMergeNodes": false,
      "chainEdgeType": "tf-chain",
      "branchEdgeType": "tf-branch-edge",
      "mergeEdgeType": "tf-merge-edge"
    },
    "nodeTypes": [
      {
        "id": "tf-entry",
        "label": "Entry",
        "icon": "log-in",
        "description": "Synthetic root entry node",
        "constraints": {
          "maxInstances": 1
        },
        "appearance": {
          "minWidth": 200,
          "minHeight": 64,
          "borderRadius": 16
        },
        "tree": {
          "allowChild": true,
          "isTerminal": false,
          "layoutSize": {
            "width": 200,
            "height": 64
          }
        },
        "body": {
          "type": "flex",
          "direction": "column",
          "gap": 4,
          "className": "tf-node-root",
          "data-slot": "tf-node",
          "data-node-variant": "entry",
          "items": [
            {
              "type": "flex",
              "data-slot": "tf-node-header",
              "items": [
                {
                  "type": "icon",
                  "icon": "log-in",
                  "data-slot": "tf-node-icon"
                },
                {
                  "type": "text",
                  "body": "${step.common.displayName || step.common.name}",
                  "data-slot": "tf-node-title"
                }
              ]
            },
            {
              "type": "text",
              "body": "流程开始",
              "data-slot": "tf-node-subtitle"
            }
          ]
        }
      },
      {
        "id": "tf-sequential",
        "label": "Sequential",
        "icon": "list-ordered",
        "description": "Sequential step container",
        "appearance": {
          "minWidth": 220,
          "minHeight": 80
        },
        "defaults": {
          "step": {
            "common": {
              "name": "seq"
            },
            "props": {
              "type": "sequential"
            }
          }
        },
        "tree": {
          "allowChild": true,
          "isTerminal": false,
          "layoutSize": {
            "width": 220,
            "height": 80
          }
        },
        "body": {
          "type": "flex",
          "direction": "column",
          "gap": 4,
          "className": "tf-node-root",
          "data-slot": "tf-node",
          "data-node-variant": "sequential",
          "items": [
            {
              "type": "flex",
              "data-slot": "tf-node-header",
              "items": [
                {
                  "type": "icon",
                  "icon": "list-ordered",
                  "data-slot": "tf-node-icon"
                },
                {
                  "type": "text",
                  "body": "${step.common.displayName || step.common.name}",
                  "data-slot": "tf-node-title"
                }
              ]
            },
            {
              "type": "text",
              "body": "顺序执行",
              "data-slot": "tf-node-subtitle"
            }
          ]
        },
        "inspector": {
          "body": {
            "type": "form",
            "body": [
              {
                "type": "input-text",
                "name": "step.common.name",
                "label": "Name"
              }
            ]
          }
        }
      },
      {
        "id": "tf-parallel",
        "label": "Parallel",
        "icon": "columns",
        "description": "Parallel execution",
        "appearance": {
          "minWidth": 220,
          "minHeight": 80
        },
        "defaults": {
          "step": {
            "common": {
              "name": "parallel"
            },
            "props": {
              "type": "parallel"
            }
          }
        },
        "tree": {
          "allowChild": true,
          "allowBranches": true,
          "minBranches": 2,
          "maxBranches": 10,
          "isTerminal": false,
          "layoutSize": {
            "width": 220,
            "height": 80
          }
        },
        "body": {
          "type": "flex",
          "direction": "column",
          "gap": 4,
          "className": "tf-node-root",
          "data-slot": "tf-node",
          "data-node-variant": "parallel",
          "items": [
            {
              "type": "flex",
              "data-slot": "tf-node-header",
              "items": [
                {
                  "type": "icon",
                  "icon": "columns",
                  "data-slot": "tf-node-icon"
                },
                {
                  "type": "text",
                  "body": "${step.common.displayName || step.common.name}",
                  "data-slot": "tf-node-title"
                }
              ]
            },
            {
              "type": "text",
              "body": "并行分支",
              "data-slot": "tf-node-subtitle"
            }
          ]
        },
        "inspector": {
          "body": {
            "type": "form",
            "body": [
              {
                "type": "input-text",
                "name": "step.common.name",
                "label": "Name"
              },
              {
                "type": "select",
                "name": "step.props.joinType",
                "label": "Join Type",
                "options": {
                  "values": [
                    {
                      "label": "Join All",
                      "value": "joinAll"
                    },
                    {
                      "label": "Cancel On Error",
                      "value": "cancelOnError"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      {
        "id": "tf-script",
        "label": "Script",
        "icon": "code",
        "description": "Script step",
        "appearance": {
          "minWidth": 220,
          "minHeight": 80
        },
        "defaults": {
          "step": {
            "common": {
              "name": "script"
            },
            "props": {
              "type": "script",
              "lang": "js"
            }
          }
        },
        "tree": {
          "allowChild": true,
          "isTerminal": false,
          "layoutSize": {
            "width": 220,
            "height": 80
          }
        },
        "body": {
          "type": "flex",
          "direction": "column",
          "gap": 4,
          "className": "tf-node-root",
          "data-slot": "tf-node",
          "data-node-variant": "script",
          "items": [
            {
              "type": "flex",
              "data-slot": "tf-node-header",
              "items": [
                {
                  "type": "icon",
                  "icon": "code",
                  "data-slot": "tf-node-icon"
                },
                {
                  "type": "text",
                  "body": "${step.common.displayName || step.common.name}",
                  "data-slot": "tf-node-title"
                }
              ]
            },
            {
              "type": "text",
              "body": "脚本节点",
              "data-slot": "tf-node-subtitle"
            }
          ]
        },
        "inspector": {
          "body": {
            "type": "form",
            "body": [
              {
                "type": "input-text",
                "name": "step.common.name",
                "label": "Name"
              },
              {
                "type": "select",
                "name": "step.props.lang",
                "label": "Language",
                "options": {
                  "values": [
                    {
                      "label": "JavaScript",
                      "value": "js"
                    },
                    {
                      "label": "XPL",
                      "value": "xpl"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      {
        "id": "tf-invoke",
        "label": "Invoke",
        "icon": "zap",
        "description": "Invoke bean method",
        "appearance": {
          "minWidth": 220,
          "minHeight": 80
        },
        "defaults": {
          "step": {
            "common": {
              "name": "invoke"
            },
            "props": {
              "type": "invoke",
              "bean": "",
              "method": ""
            }
          }
        },
        "tree": {
          "allowChild": true,
          "isTerminal": false,
          "layoutSize": {
            "width": 220,
            "height": 80
          }
        },
        "body": {
          "type": "flex",
          "direction": "column",
          "gap": 4,
          "className": "tf-node-root",
          "data-slot": "tf-node",
          "data-node-variant": "invoke",
          "items": [
            {
              "type": "flex",
              "data-slot": "tf-node-header",
              "items": [
                {
                  "type": "icon",
                  "icon": "zap",
                  "data-slot": "tf-node-icon"
                },
                {
                  "type": "text",
                  "body": "${step.common.displayName || step.common.name}",
                  "data-slot": "tf-node-title"
                }
              ]
            },
            {
              "type": "text",
              "body": "服务调用",
              "data-slot": "tf-node-subtitle"
            }
          ]
        },
        "inspector": {
          "body": {
            "type": "form",
            "body": [
              {
                "type": "input-text",
                "name": "step.common.name",
                "label": "Name"
              },
              {
                "type": "input-text",
                "name": "step.props.bean",
                "label": "Bean"
              },
              {
                "type": "input-text",
                "name": "step.props.method",
                "label": "Method"
              }
            ]
          }
        }
      },
      {
        "id": "tf-if",
        "label": "If Condition",
        "icon": "git-branch",
        "description": "Conditional with then/else branches",
        "appearance": {
          "minWidth": 220,
          "minHeight": 80
        },
        "defaults": {
          "step": {
            "common": {
              "name": "condition"
            },
            "props": {
              "type": "if"
            }
          }
        },
        "tree": {
          "allowChild": true,
          "allowBranches": true,
          "minBranches": 2,
          "maxBranches": 2,
          "isTerminal": false,
          "layoutSize": {
            "width": 220,
            "height": 80
          }
        },
        "body": {
          "type": "flex",
          "direction": "column",
          "gap": 4,
          "className": "tf-node-root",
          "data-slot": "tf-node",
          "data-node-variant": "if",
          "items": [
            {
              "type": "flex",
              "data-slot": "tf-node-header",
              "items": [
                {
                  "type": "icon",
                  "icon": "git-branch",
                  "data-slot": "tf-node-icon"
                },
                {
                  "type": "text",
                  "body": "${step.common.displayName || step.common.name}",
                  "data-slot": "tf-node-title"
                }
              ]
            },
            {
              "type": "text",
              "body": "条件分支",
              "data-slot": "tf-node-subtitle"
            }
          ]
        },
        "inspector": {
          "body": {
            "type": "form",
            "body": [
              {
                "type": "input-text",
                "name": "step.common.name",
                "label": "Name"
              },
              {
                "type": "input-text",
                "name": "step.props.condition",
                "label": "Condition"
              }
            ]
          }
        }
      },
      {
        "id": "tf-choose",
        "label": "Choose",
        "icon": "list",
        "description": "Multi-branch choose",
        "appearance": {
          "minWidth": 220,
          "minHeight": 80
        },
        "defaults": {
          "step": {
            "common": {
              "name": "choose"
            },
            "props": {
              "type": "choose"
            }
          }
        },
        "tree": {
          "allowChild": true,
          "allowBranches": true,
          "minBranches": 1,
          "maxBranches": 10,
          "isTerminal": false,
          "layoutSize": {
            "width": 220,
            "height": 80
          }
        },
        "body": {
          "type": "flex",
          "direction": "column",
          "gap": 4,
          "className": "tf-node-root",
          "data-slot": "tf-node",
          "data-node-variant": "choose",
          "items": [
            {
              "type": "flex",
              "data-slot": "tf-node-header",
              "items": [
                {
                  "type": "icon",
                  "icon": "list",
                  "data-slot": "tf-node-icon"
                },
                {
                  "type": "text",
                  "body": "${step.common.displayName || step.common.name}",
                  "data-slot": "tf-node-title"
                }
              ]
            },
            {
              "type": "text",
              "body": "选择分支",
              "data-slot": "tf-node-subtitle"
            }
          ]
        },
        "inspector": {
          "body": {
            "type": "form",
            "body": [
              {
                "type": "input-text",
                "name": "step.common.name",
                "label": "Name"
              },
              {
                "type": "input-text",
                "name": "step.props.decider",
                "label": "Decider"
              }
            ]
          }
        }
      },
      {
        "id": "tf-delay",
        "label": "Delay",
        "icon": "clock",
        "description": "Delay step",
        "appearance": {
          "minWidth": 220,
          "minHeight": 80
        },
        "defaults": {
          "step": {
            "common": {
              "name": "delay"
            },
            "props": {
              "type": "delay",
              "delayMillisExpr": "1000"
            }
          }
        },
        "tree": {
          "allowChild": true,
          "isTerminal": false,
          "layoutSize": {
            "width": 220,
            "height": 80
          }
        },
        "body": {
          "type": "flex",
          "direction": "column",
          "gap": 4,
          "className": "tf-node-root",
          "data-slot": "tf-node",
          "data-node-variant": "delay",
          "items": [
            {
              "type": "flex",
              "data-slot": "tf-node-header",
              "items": [
                {
                  "type": "icon",
                  "icon": "clock",
                  "data-slot": "tf-node-icon"
                },
                {
                  "type": "text",
                  "body": "${step.common.displayName || step.common.name}",
                  "data-slot": "tf-node-title"
                }
              ]
            },
            {
              "type": "text",
              "body": "${(step.props && step.props.delayMillisExpr) ? step.props.delayMillisExpr + 'ms' : '定时延时'}",
              "data-slot": "tf-node-subtitle"
            }
          ]
        },
        "inspector": {
          "body": {
            "type": "form",
            "body": [
              {
                "type": "input-text",
                "name": "step.common.name",
                "label": "Name"
              },
              {
                "type": "input-text",
                "name": "step.props.delayMillisExpr",
                "label": "Delay (ms)"
              }
            ]
          }
        }
      },
      {
        "id": "tf-end",
        "label": "End",
        "icon": "stop-circle",
        "description": "Terminal node",
        "constraints": {
          "maxInstances": 1
        },
        "appearance": {
          "minWidth": 200,
          "minHeight": 64,
          "borderRadius": 16
        },
        "tree": {
          "allowChild": false,
          "isTerminal": true,
          "layoutSize": {
            "width": 200,
            "height": 64
          }
        },
        "body": {
          "type": "flex",
          "direction": "column",
          "gap": 4,
          "className": "tf-node-root",
          "data-slot": "tf-node",
          "data-node-variant": "end",
          "items": [
            {
              "type": "flex",
              "data-slot": "tf-node-header",
              "items": [
                {
                  "type": "icon",
                  "icon": "stop-circle",
                  "data-slot": "tf-node-icon"
                },
                {
                  "type": "text",
                  "body": "${step.common.displayName || step.common.name}",
                  "data-slot": "tf-node-title"
                }
              ]
            },
            {
              "type": "text",
              "body": "流程结束",
              "data-slot": "tf-node-subtitle"
            }
          ]
        }
      }
    ],
    "edgeTypes": [
      {
        "id": "tf-chain",
        "label": "Chain",
        "appearance": {
          "stroke": "#6366f1",
          "strokeWidth": 2
        }
      },
      {
        "id": "tf-branch-edge",
        "label": "Branch",
        "appearance": {
          "stroke": "#22c55e",
          "strokeWidth": 2
        }
      },
      {
        "id": "tf-merge-edge",
        "label": "Merge",
        "appearance": {
          "stroke": "#a855f7",
          "strokeWidth": 2
        }
      }
    ],
    "toolbar": {
      "items": [
        {
          "type": "title",
          "body": "TaskFlow (Tree)"
        },
        {
          "type": "text",
          "text": "Container: ${doc.name}"
        },
        {
          "type": "spacer"
        },
        {
          "type": "button",
          "action": "taskflow:exit-container",
          "label": "Back",
          "icon": "arrow-left"
        },
        {
          "type": "button",
          "action": "designer:export",
          "label": "Export",
          "icon": "download"
        },
        {
          "type": "button",
          "action": "taskflow-page:request-import",
          "label": "Import",
          "icon": "upload"
        },
        {
          "type": "button",
          "action": "taskflow:save",
          "label": "Save",
          "icon": "save",
          "then": [
            {
              "action": "showToast",
              "args": {
                "message": "已保存",
                "level": "success"
              }
            }
          ]
        },
        {
          "type": "button",
          "action": "designer:undo",
          "label": "Undo",
          "icon": "undo"
        },
        {
          "type": "button",
          "action": "designer:redo",
          "label": "Redo",
          "icon": "redo"
        }
      ]
    },
    "features": {
      "undo": true,
      "redo": true,
      "grid": true,
      "minimap": true
    },
    "rules": {
      "defaultEdgeType": "tf-chain"
    },
    "canvas": {
      "background": "dots",
      "gridSize": 20,
      "snapToGrid": true,
      "minZoom": 0.25,
      "maxZoom": 4
    }
  }
}
