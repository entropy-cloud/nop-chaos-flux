{
  "name": "nop-chaos-flux-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "analyze": "turbo run analyze --filter=@nop-chaos/flux-playground",
    "audit:deps": "depcruise --config .dependency-cruiser.mjs apps packages scripts",
    "audit:knip": "knip --config knip.json",
    "audit:knip:packages": "knip --config knip.json --workspace \"./packages/*\"",
    "audit:knip:playground": "knip --config knip.json --workspace ./apps/playground",
    "audit:mutants": "stryker run stryker.runtime.conf.mjs --plugins @stryker-mutator/vitest-runner",
    "audit:mutants:canary": "node scripts/mutation/canary-selfcheck.mjs",
    "audit:mutants:formula": "stryker run stryker.formula.conf.mjs --plugins @stryker-mutator/vitest-runner",
    "audit:react-doctor": "npx react-doctor@latest . --verbose -y",
    "audit:semgrep": "semgrep --config .semgrep.yml .",
    "build": "turbo run build",
    "check": "pnpm check:react19 && pnpm check:src-artifacts && pnpm check:oversized-code-files && pnpm check:active-doc-code-anchors && pnpm check:package-css-exports && pnpm check:flux-bundle-pack && pnpm check:bundle-size && pnpm check:i18n-keys && pnpm check:workspace-manifest-deps && pnpm check:page-designer-boundary && pnpm check:schema-prop-coverage && pnpm check:scada-symbol-keys && pnpm check:scanner-baselines && pnpm check:audit-renderer-browser-io && pnpm check:audit-event-dispatch-ctx && pnpm check:ai-engine-invariants && pnpm check:audit-ui-consistency-gaps && pnpm check:ui-family-nesting && pnpm check:duplicates-baseline && pnpm check:console-baseline && pnpm check:docs-garbled && pnpm check:jsdom-pragma-whitelist && pnpm check:knip-baseline && pnpm check:audit-runtime-raw-schema-reads && pnpm check:audit-renderer-metamodel-residue && pnpm check:designer-conformance && pnpm check:windows-safe-filenames && pnpm check:wiring-coverage && pnpm check:owner-doc-semantics && pnpm check:baseline-line-keys && pnpm check:deps-baseline",
    "check:active-doc-code-anchors": "node scripts/check-active-doc-code-anchors.mjs",
    "check:ai-engine-invariants": "node scripts/audit/find-ai-engine-invariant-violations.mjs",
    "check:audit-as-any-casts": "node scripts/audit/find-as-any-casts.mjs",
    "check:audit-async-failure-paths": "node scripts/audit/find-async-without-failure-path.mjs",
    "check:audit-canvas-wrapper-a11y": "node scripts/audit/find-canvas-wrapper-a11y-gaps.mjs",
    "check:audit-event-dispatch-ctx": "node scripts/audit/find-event-dispatch-without-ctx.mjs",
    "check:audit-fieldframe-bypasses": "node scripts/audit/find-fieldframe-bypasses.mjs",
    "check:audit-hardcoded-type-dispatch": "node scripts/audit/find-hardcoded-type-dispatch.mjs",
    "check:audit-missing-renderer-markers": "node scripts/audit/find-missing-renderer-markers.mjs",
    "check:audit-non-retained-renderer-references": "node scripts/audit/find-non-retained-renderer-references.mjs",
    "check:audit-performance-suspects": "node scripts/audit/find-performance-suspects.mjs",
    "check:audit-react19-optimization-candidates": "node scripts/audit/find-react19-optimization-candidates.mjs",
    "check:audit-reactive-render-reads": "node scripts/audit/find-reactive-render-reads.mjs",
    "check:audit-renderer-browser-io": "node scripts/audit/find-renderer-browser-io.mjs",
    "check:audit-renderer-metamodel-residue": "node scripts/audit/find-renderer-metamodel-residue.mjs",
    "check:audit-runtime-raw-schema-reads": "node scripts/audit/find-runtime-raw-schema-reads.mjs",
    "check:audit-styling-suspects": "node scripts/audit/find-styling-suspects.mjs",
    "check:audit-suspects": "node scripts/audit/discover-audit-suspects.mjs",
    "check:audit-test-global-leaks": "node scripts/audit/find-test-global-leaks.mjs",
    "check:audit-todo-exitless": "node scripts/audit/find-todo-exitless.mjs",
    "check:audit-ui-consistency-gaps": "node scripts/audit/find-ui-consistency-gaps.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:console-baseline": "node scripts/check-console-baseline.mjs",
    "check:designer-conformance": "node scripts/check-designer-conformance.mjs",
    "check:docs-garbled": "node scripts/check-docs-garbled.mjs",
    "check:duplicates-baseline": "node scripts/check-duplicates.mjs",
    "check:duplicates:detail": "jscpd packages/ --config .jscpd.json",
    "check:finite-prop-contracts": "node scripts/check-finite-prop-contracts.mjs",
    "check:flux-bundle-pack": "node scripts/check-flux-bundle-pack.mjs",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check:jsdom-pragma-whitelist": "node scripts/check-jsdom-pragma-whitelist.mjs",
    "check:knip-baseline": "node scripts/check-knip-baseline.mjs",
    "check:oversized-code-files": "node scripts/check-oversized-code-files.mjs",
    "check:owner-doc-semantics": "node scripts/check-owner-doc-semantics.mjs",
    "check:package-css-exports": "node scripts/check-package-css-exports.mjs",
    "check:page-designer-boundary": "node scripts/check-page-designer-import-boundary.mjs",
    "check:react19": "node scripts/check-react19-legacy-apis.mjs",
    "check:renderer-definition-fields-only": "node scripts/check-renderer-definition-fields-only.mjs",
    "check:scada-symbol-keys": "node scripts/check-scada-symbol-keys.mjs",
    "check:scanner-baselines": "node scripts/check-scanner-baselines.mjs",
    "check:schema-prop-coverage": "node scripts/check-schema-prop-coverage.mjs",
    "check:src-artifacts": "node scripts/verify-no-src-artifacts.mjs",
    "check:ui-family-nesting": "node scripts/audit/check-ui-family-class-nesting.mjs",
    "check:windows-safe-filenames": "node scripts/check-windows-safe-filenames.mjs",
    "check:wiring-coverage": "node scripts/check-wiring-coverage.mjs",
    "check:workspace-manifest-deps": "node scripts/check-workspace-manifest-deps.mjs",
    "clean": "pnpm -r exec npx rimraf node_modules dist && npx rimraf node_modules",
    "clean:cache": "rimraf --glob .turbo \"packages/*/node_modules/.cache\" \"apps/*/node_modules/.cache\" node_modules/.cache .vite",
    "clean:src-artifacts": "node scripts/clean-src-artifacts.mjs",
    "dev": "turbo run dev --filter=@nop-chaos/flux-playground",
    "flux-guide:generate-types": "node flux-guide/scripts/generate-types.mjs",
    "flux-guide:validate": "pnpm build && node --experimental-loader ./flux-guide/scripts/css-stub.mjs --import ./flux-guide/scripts/env-stub.mjs flux-guide/scripts/validate.mjs",
    "flux:validate-pages": "node --experimental-loader ./flux-guide/scripts/css-stub.mjs --import ./flux-guide/scripts/env-stub.mjs flux-guide/scripts/validate-pages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/clean-src-artifacts.mjs && node scripts/verify-no-src-artifacts.mjs && node scripts/check-react19-legacy-apis.mjs && node scripts/check-active-doc-code-anchors.mjs && node scripts/check-package-css-exports.mjs && node scripts/check-renderer-definition-fields-only.mjs && node scripts/check-finite-prop-contracts.mjs && node scripts/check-i18n-keys.mjs && node scripts/check-schema-prop-coverage.mjs && node scripts/check-scada-symbol-keys.mjs && turbo run lint",
    "pack:flux-bundle": "node scripts/pack-flux-bundle.mjs",
    "prepare": "husky",
    "test": "turbo run test --concurrency=2",
    "test:coverage": "turbo run test --concurrency=2 -- --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "tsc": "tsc",
    "tsc6": "tsc6",
    "typecheck": "turbo run typecheck",
    "visual:capture": "node scripts/visual-quality/capture-visual-matrix.mjs",
    "visual:inventory": "vitest run --config scripts/visual-quality/vitest.inventory.config.ts",
    "visual:reconcile": "node scripts/visual-quality/reconcile-coverage.mjs",
    "interaction:inventory": "vitest run --config scripts/interaction-state/vitest.inventory.config.ts",
    "interaction:reconcile": "node scripts/interaction-state/reconcile-coverage.mjs",
    "workaround:inventory": "vitest run --config scripts/workaround-audit/vitest.inventory.config.ts",
    "workaround:reconcile": "node scripts/workaround-audit/reconcile-coverage.ts",
    "check:baseline-line-keys": "node scripts/check-baseline-line-keys.mjs",
    "check:deps-baseline": "node scripts/check-deps-baseline.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^17.3.10",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.4.0",
    "happy-dom": "^15.11.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "knip": "6.9.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "three": "0.186.0",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "dts-bundle-generator>typescript": "npm:@typescript/typescript6@6.0.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{json,md,css}": "prettier --write"
  }
}
