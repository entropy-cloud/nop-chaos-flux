{
  "type": "page",
  "xui:imports": [{ "from": "ai", "as": "ai" }],
  "body": [
    {
      "type": "ai-chat",
      "testid": "ai-attachments-chat",
      "connector": "${$ai.connectors.mock}",
      "placeholder": "Attach an image below, then send…",
      "submitType": "enter",
      "header": {
        "type": "flex",
        "direction": "row",
        "align": "center",
        "justify": "between",
        "className": "p-3 border-b",
        "body": [
          { "type": "text", "text": "AI Attachments (P2 multimodal)" },
          {
            "type": "text",
            "text": "image/card preview · drag-drop · validation · image_url send",
            "className": "text-xs text-muted-foreground"
          }
        ]
      },
      "beforeMessages": {
        "type": "ai-attachments",
        "testid": "ai-attachments-demo",
        "mode": "auto",
        "accept": "image/*",
        "multiple": true,
        "maxFiles": 4,
        "maxSize": 5242880,
        "enableDrop": true
      },
      "className": "flex flex-col h-[70vh] max-w-3xl mx-auto p-4 gap-3"
    }
  ]
}
